{ @author: Sylvain Maltais (support@gladir.com)
  @created: 2026
  @website(https://www.gladir.com/translate-0)
  @website(https://www.gladir.com/vie)
  @abstract(Target: Free Pascal 3.2)
  @description: Clone de la commande argos-translate (traduction de phrases) :
                argos-translate --from-lang en --to-lang fr "Hello, how are
                  you?"

  Argos Translate utilise des reseaux de neurones (OpenNMT / CTranslate2) dont
    les
  modeles pesent plusieurs dizaines de Mo : ils ne sont pas realisables en
    Pascal.
  Ce clone est un traducteur A REGLES, sans reseau : anglais -> francais,
    anglais ->
  allemand, francais -> anglais, allemand -> anglais, allemand -> francais,
  japonais (romaji) -> anglais, japonais (romaji) -> francais, espagnol ->
    anglais,
  espagnol -> francais, albanais -> anglais, albanais -> francais, portugais ->
    anglais,
  portugais -> francais, suedois -> anglais, suedois -> francais, danois ->
    anglais, danois -> francais, italien -> anglais, italien -> francais, latin
    -> anglais, latin -> francais, gallois -> anglais, gallois -> francais,
    afrikaans -> anglais, afrikaans ->
  francais, maltais -> anglais, maltais -> francais, islandais -> anglais,
    islandais ->
  francais, neerlandais -> anglais, neerlandais -> francais, norvegien ->
    anglais, norvegien -> francais, polonais -> anglais, polonais -> francais,
    roumain -> anglais, roumain -> francais, catalan -> anglais, catalan ->
    francais, ancien francais (roman) -> francais moderne et innu-aimun
  (montagnais) -> francais (mots et phrases connus seulement).
    - lexique d'environ 600 mots (noms avec genre, adjectifs avec accord et
      place,
      verbes avec groupe et auxiliaire, adverbes, prepositions) ;
    - verbes irreguliers francais (present, futur, conditionnel, imparfait,
      participe) ;
    - formes irregulieres anglaises, contractions (don't, I'm, ...), locutions ;
    - analyse d'un groupe nominal (determinant, adjectifs, noms) avec accord ;
    - phrases declaratives, negatives, interrogatives (est-ce que, inversion,
      mots
      interrogatifs) et imperatives, presents, passes (passe compose), futurs ;
    - post-traitement : elisions (j', l', n'), contractions (du, au, des, aux),
      ponctuation francaise et majuscule initiale.
    - allemand : cas (nominatif, accusatif, datif), declinaison des articles et
      des
      adjectifs, genre et pluriel des noms, verbes forts/faibles/separables,
        parfait,
      ordre des mots (verbe en 2e position, verbe final des subordonnees),
        negation
      (nicht/kein), contractions (im, zum, zur...) et "Sie" de politesse.
    - francais -> anglais : lecture des formes conjuguees (present, futur,
      conditionnel,
      imparfait, passe compose), pronoms, negation (ne ... pas), inversions et
        "est-ce
      que", groupes nominaux, puis generation anglaise (auxiliaires
        do/will/have, -s,
      temps du passe, ordre des adjectifs).
    - allemand -> anglais : formes conjuguees, participes, prefixes separables,
      cas des
      groupes nominaux (article, genre), ordre des mots (verbe 2e / verbe
        final), puis
      generation anglaise ; allemand -> francais passe par l'anglais (traduction
        pivot).
    - japonais (romaji) : particules (wa, ga, o, ni, de, to, no...), formes
      polies et
      neutres des verbes et des adjectifs (-masu, -te, -ta, -nai, -tai), copule
        desu,
      lexique d'environ 350 mots ; japonais -> francais passe par l'anglais.
    - espagnol : formes conjuguees (presents, preterit, imparfait, futur,
      conditionnel,
      participes, gerondifs, verbes irreguliers et a diphtongue), pronoms sujets
        omis
      et enclitiques, accords noms/adjectifs, ser/estar/haber/tener, gustar,
        hay,
      lexique d'environ 450 mots ; espagnol -> francais passe par l'anglais.
    - albanais : articles definis en suffixe, verbes reguliers et irreguliers
      (present,
      aoriste, imparfait, participe, futur "do te"), pronoms clitiques,
        possessifs
      places apres le nom, genitif, lexique d'environ 330 mots ; l'albanais est
      analyse avec la meme proposition que l'espagnol puis passe par l'anglais.
    - portugais : contractions (do, na, ao, pelo...), conjugaisons regulieres et
      irregulieres, pronoms sujets omis et enclitiques (ajuda-lo, chamo-me), ir
        +
      infinitif, ter que, estar a + infinitif, gostar de, ha ; lexique d'environ
        420
      mots ; comme l'albanais, le portugais reutilise l'analyse de l'espagnol.
    - suedois : noms a article defini en suffixe (huset, pojken), pluriels,
      adjectifs
      accordes, verbes (presents, preterits, supins, imperatifs), ordre des mots
        (verbe
      en 2e position retabli en ordre sujet-verbe), inte, ha + supin, att, ska,
      genitif en -s, det finns ; lexique d'environ 471 mots ; comme l'albanais
        et le
      portugais, le suedois reutilise l'analyse de l'espagnol puis passe par
        l'anglais.
    - danois : meme principe que le suedois (article defini en suffixe, ikke
      apres le
      verbe, verbe en 2e position, genitif en -s, der er, at) ; lexique
        d'environ 399
      mots, analyse de l'espagnol puis anglais.
    - italien : contractions (del, nel, sul...), articles elides (l', dell'),
      conjugaisons
      regulieres (-are, -ere, -ire, -isco) et irregulieres, passe compose rendu
        par un
      preterit anglais, ci + essere (il y a), partitif (del pane), fa freddo, ho
        fame,
      enclitiques (vederlo) ; lexique d'environ 441 mots ; analyse de l'espagnol
        puis
      anglais.
    - latin : cinq declinaisons (cas nominatif a ablatif, singulier et pluriel)
      et quatre
      conjugaisons engendrees depuis les formes de base, verbes irreguliers
        (sum, possum,
      eo, fero, volo, nolo), present, imparfait, futur, parfait, infinitif et
        imperatif ;
      l'ordre des mots est libre : on repere les groupes (nom + adjectifs
        accordes),
      on donne un role d'apres le cas (sujet, objet, "a", "de", ablatif), puis
        on range
      sujet - verbe - complements ; articles definis ajoutes, vocatif, -que et
        -ne,
      propositions coordonnees ; lexique d'environ 435 mots ; analyse de
        l'espagnol puis
      anglais.
    - gallois : verbe en tete (verbe - sujet - objet) remis en ordre sujet -
      verbe -
      complements, formes de "bod" (mae, dw, roedd, bydd, dydy...) avec yn +
        verbe-nom,
      passe simple (-ais, -odd...), mutations des consonnes initiales defaites
        (douce,
      nasale, aspiree), possessifs, "il y a" (mae + nom sans article),
        possession
      (mae gen i, mae ... gyda fi), negation (ddim), contractions avec
        apostrophe ('r, 'n,
      'm) ; lexique d'environ 338 mots ; analyse de l'espagnol puis anglais.
    - afrikaans : pas de conjugaison par personne (present = infinitif), passe
      avec
      "het" + participe en ge-, futur avec "sal", modaux, articles die / 'n,
        double
      negation nie ... nie, verbe en 2e position (inversion) et verbe final des
      subordonnees remis en ordre, genitif "se", "om te", "huis toe", "daar is"
        ;
      lexique d'environ 355 mots ; analyse de l'espagnol puis anglais.
    - maltais : formes de surface engendrees a la construction (parfait,
      imparfait et
      imperatif des verbes, pluriels brises des noms, feminins et pluriels des
        adjectifs),
      article colle (il-, it-, id-...) et contractions (fil-, mill-, bil-,
        tal-...),
      negation ma ... -x, qed / se / sa + imparfait, "hemm", "għandi", pronoms
      suffixes possessifs (missieri, ommi, tiegħi), phrases nominales sans
        verbe (jien
      student, il-ktieb kbir) ; lexique d'environ 1110 formes ; analyse de
        l'espagnol puis
      anglais.
    - islandais : formes de surface engendrees a la construction (noms aux
      quatre cas,
      singulier et pluriel, avec l'article defini suffixe -inn / -in / -id ;
        adjectifs ;
      verbes reguliers et forts au present, au passe, au supin ; formes
        enclitiques
      ertu, geturdu), verbe en 2e position remis en ordre sujet - verbe, ekki,
        hafa +
      supin, munu + infinitif, vera ad + infinitif, "thad er", genitif,
        possessif
      postpose (hundurinn minn) ; lexique d'environ 2985 formes ; analyse de
        l'espagnol
      puis anglais.
    - neerlandais : formes de surface engendrees a la construction (noms et
      pluriels,
      adjectifs, verbes faibles avec la regle du 't kofschip, verbes forts :
        present,
      passe simple, participe), verbe en 2e position (inversion) et verbe final
        des
      subordonnees remis en ordre, hebben / zijn + participe = passe, zullen +
        infinitif =
      futur, gaan + infinitif, geen / niet, "er is", "om te", genitif (Jans
        boek), houden
      van ; lexique d'environ 1162 formes ; analyse de l'espagnol puis anglais.
    - norvegien (bokmal) : formes de surface engendrees a la construction (noms,
      definis en -en / -a / -et, pluriels, adjectifs, verbes : infinitif,
        present,
      passe, supin, imperatif), verbe en 2e position (inversion), har + supin =
        passe,
      skal + infinitif = futur, "det er", ikke, possessifs postposes (boken
        min),
      genitif (Annas bok) ; lexique d'environ 1321 formes ; analyse de
        l'espagnol puis
      anglais.
    - polonais : formes de surface engendrees a la construction (noms avec leurs
      sept
      cas, adjectifs, verbes : present, passe en -l selon la personne et le
        genre,
      futur compose avec bede, conditionnel, imperatif, aspect parfait), sujet
        omis
      retabli d'apres la terminaison du verbe, articles ajoutes (le polonais
        n'en a
      pas), genitif du complement du nom (dom brata), instrumental sans
        preposition
      (par le train), "jest" + nom = il y a, nie ... nic, ile ... kosztuje,
        titres pan /
      pani, jours et mois ; lexique d'environ 8300 formes ; analyse de
        l'espagnol puis
      anglais.
    - roumain : formes de surface engendrees a la construction (article defini
      suffixe
      -ul / -a / -ii / -le, genitif-datif, adjectifs, verbes : present,
        imparfait,
      participe, subjonctif), perfect compose (am citit = passe), futur (voi +
        infinitif,
      o sa), conditionnel (as vrea), sa + verbe = infinitif, sujet omis retabli
        d'apres
      la terminaison du verbe, articles ajoutes, genitif (cartea copilului),
        pronoms
      lies (il vad), pe devant un objet, "este" + groupe indefini = il y a, nu
        ... nimic,
      ma cheama / ma numesc, imi place, jours et mois ; lexique d'environ 3640
        formes ;
      analyse de l'espagnol puis anglais.
    - catalan : formes de surface engendrees a la construction (pluriels,
      adjectifs,
      verbes : present, imparfait, futur, conditionnel, participe), contractions
        al / del
      / pel et elisions l', d', m', passe compose (he cantat) et passe
        periphrastique
      (vaig cantar) = passe, anar a + infinitif, sujet omis retabli d'apres la
      terminaison du verbe, articles, em dic / m'agrada, hi ha, fa fred, tinc
        fam,
      tinc trenta anys, no ... res, jours et mois ; lexique d'environ 3400
        formes ;
      analyse de l'espagnol puis anglais.
    - ancien francais (code fro, vers le francais moderne seulement) :
      modernisation mot
      a mot de textes simples (orthographe, formes verbales, articles li / le /
        les,
      contractions del, al, el), systeme a deux cas des noms (li rois = le roi,
        li roi =
      les rois), accords des adjectifs et des demonstratifs d'apres le nom
        voisin,
      ajout de "pas" apres "ne", inversion avec trait d'union (vas-tu,
        aidez-moi) ;
      lexique d'environ 607 mots ; les formes inconnues sont conservees.
  Il traduit correctement des phrases simples ; une phrase complexe peut donner
    une
  traduction approximative, et un mot inconnu est conserve tel quel.
}

{$mode objfpc}
{$H-}

Program ARGOSTRANSLATE;

Const
  Version = '1.0';
  MaxLex = 1100;
  MaxTokens = 80;
  MaxIrregular = 96;
  MaxEnglishIrregular = 120;

Type
  TLex = Record
    En: String[24];
    Fr: String[26];
    Pos: Char;          { n a v r p c j u }
    Sub: Char;          { genre m/f, place B/A, groupe e/i/r/x }
    Aux: Char;          { a = avoir, e = etre }
    Link: String[3];    { preposition apres l'infinitif : a, de }
    Fem: String[16];    { feminin irregulier de l'adjectif }
    Plu: String[18];    { pluriel irregulier }
    Idiom: String[10];  { avoir + idiom : faim, soif, froid ... }
    De: String[26];     { allemand }
    DeG: Char;          { genre : m f n, P = pluriel seulement }
    DePl: String[20];   { pluriel du nom ; radical irregulier de l'adjectif }
    DeFlags: String[6]; { w faible, s etre, d datif, S subordonnant, i
        invariable, P pluriel }
    DeSep: String[8];   { prefixe separable }
    DeCase: Char;       { cas de la preposition : a d w }
  End;

  TIrregular = Record
    Inf: String[24];
    Pres: Array[1..6] Of String[14];
    Part: String[14];
    Fut: String[14];
    Imp: String[14];
  End;

  TEnglishForm = Record
    Form: String[14];
    Base: String[14];
    Kind: Char;         { p passe, q participe, b les deux }
  End;

