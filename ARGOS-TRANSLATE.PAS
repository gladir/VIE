Var
  FromLang, ToLang, TextArg, Line, Argument: String;
  ArgumentIndex: Integer;
  ListOnly: Boolean;

BEGIN
  LoadLexicon;
  LoadIrregular;
  LoadEnglish;
  LoadGermanVerbs;
  LoadJapanese;
  LoadSpanish;
  LoadAlbanian;
  LoadPortuguese;
  LoadSwedish;
  LoadDanish;
  LoadItalian;
  LoadLatin;
  LoadWelsh;
  LoadAfrikaans;
  LoadMaltese;
  LoadIcelandic;
  LoadDutch;
  LoadNorwegian;
  LoadPolish;
  LoadRomanian;
  LoadCatalan;
  LoadOldFrench;
  LoadMoe;
  FromLang := '';
  ToLang := '';
  TextArg := '';
  ListOnly := False;
  ArgumentIndex := 1;
  While ArgumentIndex <= ParamCount Do
  Begin
    Argument := ParamStr(ArgumentIndex);
    If (Argument = '/?') Or (Argument = '-?') Or (Argument = '-h') Or (Argument
        = '--help') Then
    Begin
      ShowHelp;
      Halt(0);
    End
    Else If (Argument = '-V') Or (Argument = '--version') Then
    Begin
      Writeln('ARGOS-TRANSLATE (clone en Pascal) ', Version);
      Halt(0);
    End
    Else If (Argument = '-l') Or (Argument = '--list') Then
      ListOnly := True
    Else If (Argument = '-f') Or (Argument = '--from-lang') Then
    Begin
      If ArgumentIndex = ParamCount Then
      Begin
        Writeln('Erreur : code de langue manquant apres ', Argument);
        Halt(2);
      End;
      Inc(ArgumentIndex);
      FromLang := LowerAscii(ParamStr(ArgumentIndex));
    End
    Else If (Argument = '-t') Or (Argument = '--to-lang') Then
    Begin
      If ArgumentIndex = ParamCount Then
      Begin
        Writeln('Erreur : code de langue manquant apres ', Argument);
        Halt(2);
      End;
      Inc(ArgumentIndex);
      ToLang := LowerAscii(ParamStr(ArgumentIndex));
    End
    Else If (Copy(Argument, 1, 1) = '-') And (Length(Argument) > 1) Then
    Begin
      Writeln('Erreur : option non prise en charge : ', Argument);
      Halt(2);
    End
    Else
      TextArg := Join(TextArg, Argument);
    Inc(ArgumentIndex);
  End;

  If ListOnly Then
  Begin
    Writeln('en -> fr');
    Writeln('en -> de');
    Writeln('fr -> en');
    Writeln('de -> fr');
    Writeln('de -> en');
    Writeln('ja -> fr (romaji)');
    Writeln('ja -> en (romaji)');
    Writeln('es -> fr');
    Writeln('es -> en');
    Writeln('sq -> fr (albanais)');
    Writeln('sq -> en (albanais)');
    Writeln('pt -> fr');
    Writeln('pt -> en');
    Writeln('sv -> fr');
    Writeln('sv -> en');
    Writeln('da -> fr');
    Writeln('da -> en');
    Writeln('it -> fr');
    Writeln('it -> en');
    Writeln('la -> fr');
    Writeln('la -> en');
    Writeln('cy -> fr');
    Writeln('cy -> en');
    Writeln('af -> fr');
    Writeln('af -> en');
    Writeln('mt -> fr');
    Writeln('mt -> en');
    Writeln('is -> fr');
    Writeln('is -> en');
    Writeln('nl -> fr');
    Writeln('nl -> en');
    Writeln('no -> fr');
    Writeln('no -> en');
    Writeln('pl -> fr');
    Writeln('pl -> en');
    Writeln('ro -> fr');
    Writeln('ro -> en');
    Writeln('ca -> fr');
    Writeln('ca -> en');
    Writeln('moe -> fr (innu-aimun : phrases et mots connus seulement)');
    Writeln('fro -> fr (ancien francais : modernisation mot a mot)');
    Halt(0);
  End;
  If (FromLang = '') Or (ToLang = '') Then
  Begin
    Writeln('Erreur : indiquer --from-lang et --to-lang.');
    Halt(2);
  End;
  If (FromLang = 'inn') Or (FromLang = 'innu') Then FromLang := 'moe';
  If (FromLang = 'nb') Or (FromLang = 'nn') Then FromLang := 'no';
  If (FromLang = 'roman') Or (FromLang = 'romanz') Or (FromLang = 'ofr') Then
      FromLang := 'fro';
  If FromLang = 'fro' Then
  Begin
    If ToLang <> 'fr' Then
    Begin
      Writeln('Erreur : l''ancien francais ne se traduit que vers le francais '+
          'moderne (fro -> fr).');
      Halt(1);
    End;
    SourceFro := True;
    TargetDe := False;
    TargetEn := False;
  End;
  If FromLang = 'moe' Then
  Begin
    If ToLang <> 'fr' Then
    Begin
      Writeln('Erreur : l''innu-aimun ne se traduit que vers le francais (moe '+
          '-> fr).');
      Halt(1);
    End;
    SourceMoe := True;
    TargetDe := False;
    TargetEn := False;
  End;
  If Not (SourceMoe Or SourceFro Or ((FromLang = 'en') And ((ToLang = 'fr') Or
      (ToLang = 'de'))) Or
          ((FromLang = 'fr') And (ToLang = 'en')) Or
          ((FromLang = 'de') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'ja') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'es') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'sq') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'pt') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'sv') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'da') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'it') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'la') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'cy') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'af') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'mt') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'is') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'nl') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'no') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'pl') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'ro') And ((ToLang = 'fr') Or (ToLang = 'en'))) Or
          ((FromLang = 'ca') And ((ToLang = 'fr') Or (ToLang = 'en')))) Then
  Begin
    Writeln('Erreur : aucun modele de traduction de ', FromLang, ' vers ',
        ToLang,
            ' n''est installe (paires disponibles : en -> fr, en -> de, fr -> '+
                'en, de -> fr, de -> en, ja -> fr, ja -> en, es -> fr, es -> e'+
                'n, sq -> fr, sq -> en, pt -> fr, pt -> en, sv -> fr, sv -> en'+
                ', da -> fr, da -> en, it -> fr, it -> en, la -> fr, la -> en,'+
                ' cy -> fr, cy -> en, af -> fr, af -> en, mt -> fr, mt -> en, '+
                'is -> fr, is -> en, nl -> fr, nl -> en, no -> fr, no -> en, p'+
                'l -> fr, pl -> en, ro -> fr, ro -> en, ca -> fr, ca -> en, fr'+
                'o -> fr).');
    Halt(1);
  End;
  SourceDe := FromLang = 'de';
  SourceJa := FromLang = 'ja';
  SourceEs := FromLang = 'es';
  SourceSq := FromLang = 'sq';
  SourcePt := FromLang = 'pt';
  SourceSv := FromLang = 'sv';
  SourceDa := FromLang = 'da';
  SourceIt := FromLang = 'it';
  SourceLa := FromLang = 'la';
  SourceCy := FromLang = 'cy';
  SourceAf := FromLang = 'af';
  SourceMt := FromLang = 'mt';
  SourceIc := FromLang = 'is';
  SourceCa := FromLang = 'ca';
  SourceRo := FromLang = 'ro';
  SourcePl := FromLang = 'pl';
  SourceNb := FromLang = 'no';
  SourceNl := FromLang = 'nl';
  DeToEn := (SourceDe Or SourceJa Or SourceEs Or SourceSq Or SourcePt Or
      SourceSv Or SourceDa Or SourceIt Or SourceLa Or SourceCy Or SourceAf Or
      SourceMt Or SourceIc Or SourceNl Or SourceNb Or SourcePl Or SourceRo Or
      SourceCa) And (ToLang = 'en');
  DePivot := (SourceDe Or SourceJa Or SourceEs Or SourceSq Or SourcePt Or
      SourceSv Or SourceDa Or SourceIt Or SourceLa Or SourceCy Or SourceAf Or
      SourceMt Or SourceIc Or SourceNl Or SourceNb Or SourcePl Or SourceRo Or
      SourceCa) And (Not DeToEn);
  If SourceDe Then InitDeSpecials;
  TargetDe := ToLang = 'de';
  TargetEn := ToLang = 'en';

  If TextArg <> '' Then
    Writeln(TranslateText(TextArg))
  Else
    While Not Eof(Input) Do
    Begin
      ReadLn(Input, Line);
      If Copy(Line, 1, 3) = #$EF#$BB#$BF Then Delete(Line, 1, 3);
      If Line <> '' Then Writeln(TranslateText(Line)) Else Writeln;
    End;
END.
