Function SpPhraseKey(A, B: Integer): String;
Var
  K: Integer;
  R: String;
Begin
  R := '';
  For K := A To B Do
  Begin
    If ST[K].Punct Then
    Begin
      SpPhraseKey := '#';
      Exit;
    End;
    R := Join(R, ST[K].W);
  End;
  SpPhraseKey := R;
End;

Function FindPhraseEs(Const Key: String): String;
Var
  N: Integer;
  Pair, K: String;
Begin
  FindPhraseEs := '';
  If Key = '#' Then Exit;
  For N := 0 To High(PhrasesEs) Do
  Begin
    Pair := PhrasesEs[N];
    K := CopyUntil(Pair, '|');
    If K = Key Then
    Begin
      FindPhraseEs := Pair;
      Exit;
    End;
  End;
End;


