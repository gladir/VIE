Function AfVerbKey(I: Integer): String;
Begin
  If (I >= 1) And (I <= SN) And (ST[I].Cat = 'V') And (ST[I].Idx > 0) Then
    AfVerbKey := SpPlain(SpLex[ST[I].Idx].Es)
  Else
    AfVerbKey := '';
End;

Procedure AfInsert(Pos1: Integer);
Var
  K: Integer;
Begin
  If SN >= MaxTokens Then Exit;
  For K := SN Downto Pos1 Do
    ST[K + 1] := ST[K];
  Inc(SN);
  FillChar(ST[Pos1], SizeOf(TSTok), 0);
  ST[Pos1].Tns := ' ';
End;

{ Fin du groupe nominal sujet qui commence en K (0 s'il n'y en a pas). }
Function AfSubjEnd(K: Integer): Integer;
Var
  J: Integer;
Begin
  AfSubjEnd := 0;
  If (K < 1) Or (K > SN) Then Exit;
  If ST[K].Cat = 'P' Then
  Begin
    AfSubjEnd := K;
    Exit;
  End;
  J := K;
  While (J <= SN) And (ST[J].Cat In ['D', 'S', 'T', 'Q', 'U']) Do Inc(J);
  While (J <= SN) And (ST[J].Cat = 'A') Do Inc(J);
  If (J <= SN) And (ST[J].Cat = 'N') Then
    AfSubjEnd := J
  Else If (J <= SN) And (ST[J].Cat = 'Z') And ST[J].Cap And (J > 1) Then
  Begin
    While (J < SN) And (ST[J + 1].Cat = 'Z') Do Inc(J);
    AfSubjEnd := J;
  End;
End;

Function AfSubjBefore(I: Integer): Boolean;
Var
  J: Integer;
Begin
  AfSubjBefore := False;
  If I <= 1 Then Exit;
  If ST[I - 1].Cat = 'P' Then
  Begin
    AfSubjBefore := True;
    Exit;
  End;
  J := I - 1;
  While (J >= 1) And (ST[J].Cat In ['N', 'A', 'D', 'S', 'T', 'Q', 'U', 'Z']) Do
      Dec(J);
  If J < I - 1 Then
    AfSubjBefore := (J < 1) Or (ST[J].Cat <> 'E');
End;

{ deplace les jetons From1..To1 juste avant la position Dest (Dest < From1) }
Procedure AfMoveBlock(From1, To1, Dest: Integer);
Var
  Tmp: Array[1..12] Of TSTok;
  N, K: Integer;
Begin
  N := To1 - From1 + 1;
  If (N < 1) Or (N > 12) Or (Dest >= From1) Then Exit;
  For K := 1 To N Do Tmp[K] := ST[From1 + K - 1];
  For K := From1 - 1 Downto Dest Do ST[K + N] := ST[K];
  For K := 1 To N Do ST[Dest + K - 1] := Tmp[K];
End;

Function AfFirstW: String;
Var
  K: Integer;
Begin
  AfFirstW := '';
  For K := 1 To SN Do
    If ST[K].Cat = 'W' Then
    Begin
      AfFirstW := ST[K].W;
      Exit;
    End;
End;

{ verbes auxiliaires et modaux qui appellent un verbe en fin de proposition }
Function AfIsAux(I: Integer): Boolean;
Begin
  AfIsAux := (ST[I].Cat = 'V') And InList(ST[I].W,
      'het is was had sal sou kan wil moet mag kon wou moes gaan');
End;

{ Fin de la proposition qui commence en A : avant une virgule ou une conjonction
  }
Function AfClauseEnd(A: Integer): Integer;
Var
  K: Integer;
Begin
  K := A;
  While (K < SN) And (Not (ST[K + 1].Cat = ',')) And
        (Not ((ST[K + 1].Cat = 'C') And InList(ST[K + 1].W,
            'dat omdat as toe terwyl wanneer sodat hoewel indien en maar of wa'+
            'nt'))) Do
    Inc(K);
  AfClauseEnd := K;
End;

{ Le verbe final d'une proposition principale vient juste apres l'auxiliaire :
  Ek het 'n boek gelees -> Ek het gelees 'n boek ; dans les subordonnees, le
    groupe
  verbal final passe apres le sujet. }
Procedure AfFixClauses;
Var
  A, B, I, J, E, K, Last, FirstV, Cnt: Integer;
  Sub: Boolean;
  T1, T2: TSTok;
Begin
  A := 1;
  While A <= SN Do
  Begin
    If ST[A].Cat = ',' Then
      Inc(A)
    Else
    Begin
      Sub := (ST[A].Cat = 'C') And InList(ST[A].W,
          'dat omdat as toe terwyl wanneer sodat hoewel indien');
      B := AfClauseEnd(A);
      If Sub Then
      Begin
        { groupe verbal final }
        Last := B;
        While (Last > A) And (ST[Last].Cat = 'G') Do Dec(Last);
        J := Last;
        While (J > A) And (ST[J].Cat = 'V') Do Dec(J);
        If J < Last Then
        Begin
          { sujet apres la conjonction }
          E := AfSubjEnd(A + 1);
          If (E > 0) And (E < J + 1) And (Last - J <= 3) Then
          Begin
            { participe puis auxiliaire : on inverse }
            If (Last - J = 2) And (ST[Last].W = 'het') And (ST[J + 1].Tns = 'P')
                Then
            Begin
              T1 := ST[J + 1];
              T2 := ST[Last];
              ST[J + 1] := T2;
              ST[Last] := T1;
            End;
            AfMoveBlock(J + 1, Last, E + 1);
          End;
        End;
      End
      Else
      Begin
        { auxiliaire en deuxieme position, verbe en fin de proposition }
        FirstV := 0;
        For I := A To B Do
          If (FirstV = 0) And AfIsAux(I) Then FirstV := I;
        If FirstV > 0 Then
        Begin
          Last := 0;
          For I := B Downto FirstV + 1 Do
            If (Last = 0) And (ST[I].Cat = 'V') And (Not AfIsAux(I) Or
                (ST[I].Tns = 'P')) Then Last := I;
          If (Last > FirstV + 1) Then
          Begin
            AfMoveBlock(Last, Last, FirstV + 1);
          End;
        End;
      End;
      A := B + 1;
    End;
  End;
  Cnt := 0;
  K := 0;
End;

Procedure AfClassify;
Var
  I, J, K, E, S1: Integer;
  Key, Owner: String;
Begin
  AfMergeMultiword;
  { dis = dit is }
  I := 1;
  While I <= SN Do
  Begin
    If (ST[I].W = 'dis') And (SN < MaxTokens) Then
    Begin
      AfInsert(I + 1);
      ST[I].W := 'dit';
      ST[I].Orig := 'dit';
      ST[I + 1].W := 'is';
      ST[I + 1].Orig := 'is';
      ST[I + 1].Cap := False;
      Inc(I);
    End;
    Inc(I);
  End;
  For I := 1 To SN Do
    AfPickCat(I);
  { kyk na = regarder ; kyk + objet = regarder (un film) }
  For I := 1 To SN - 1 Do
    If (ST[I].Cat = 'V') And (ST[I].W = 'kyk') And (ST[I + 1].Cat = 'E') And
        (ST[I + 1].W = 'a') Then
      ST[I].En := 'look';
  For I := 1 To SN Do
    If ST[I].Cat = 'Z' Then ST[I].Orig := AfProperEn(ST[I].Orig);
  { Kaapstad toe : vers Le Cap }
  For I := 2 To SN Do
    If (ST[I].W = 'toe') And (ST[I].Cat In ['C', 'R', 'E']) And (ST[I - 1].Cat
        In ['N', 'Z']) Then
    Begin
      K := I - 1;
      While (K > 1) And (ST[K - 1].Cat In ['A', 'D', 'S', 'T', 'Q', 'U']) Do
          Dec(K);
      ST[I].Cat := ' ';
      If ST[I - 1].W = 'huis' Then
      Begin
        ST[I - 1].Cat := 'R';
        ST[I - 1].En := 'home';
      End
      Else
      Begin
        AfInsert(K);
        ST[K].Cat := 'E';
        ST[K].W := 'a';
        ST[K].Orig := 'na';
        ST[K].En := 'to';
      End;
      Break;
    End;
  { om te + verbe : l'infinitif }
  For I := 1 To SN - 2 Do
    If (ST[I].W = 'om') And (ST[I + 1].W = 'te') And (ST[I + 2].Cat = 'V') Then
    Begin
      ST[I].Cat := ' ';
      ST[I + 1].Cat := ' ';
      ST[I + 2].Tns := 'I';
    End;
  { genitif : die seun se boek = le livre du garcon }
  I := 2;
  While I < SN Do
  Begin
    If (ST[I].W = 'se') And (ST[I - 1].Cat In ['N', 'Z']) And (ST[I + 1].Cat In
        ['N', 'A', 'D', 'S']) Then
    Begin
      K := I - 1;
      While (K > 1) And (ST[K - 1].Cat In ['A', 'D']) Do Dec(K);
      S1 := I + 1;
      If ST[S1].Cat = 'D' Then Inc(S1);
      E := S1;
      While (E < SN) And (ST[E].Cat = 'A') Do Inc(E);
      If (ST[E].Cat = 'N') And (E - I <= 5) And (SN + 2 <= MaxTokens) Then
      Begin
        { texte du possesseur }
        Owner := '';
        If ST[I - 1].Cat = 'Z' Then
          Owner := ST[I - 1].Orig
        Else
        Begin
          If ST[K].Cat = 'D' Then
            If ST[K].Kind = 'd' Then Owner := 'the';
          For J := K To I - 1 Do
            If ST[J].Cat = 'A' Then Owner := Join(Owner, ST[J].En);
          Key := ST[I - 1].En;
          If ST[I - 1].Plu Then Key := EnPlural(Key);
          Owner := Join(Owner, Key);
        End;
        { le possede (apres "se") passe devant ; puis "de" et le possesseur }
        ST[0] := ST[I - 1];
        ST[0].Cat := 'Z';
        ST[0].Orig := Owner;
        ST[0].Cap := True;
        ST[0].Plu := False;
        { retire K..I (possesseur et se), recopie le possede }
        For J := K To I Do
          ST[J].Cat := ' ';
        AfInsert(E + 1);
        ST[E + 1].Cat := 'E';
        ST[E + 1].W := 'de';
        ST[E + 1].Orig := 'de';
        ST[E + 1].En := 'of';
        AfInsert(E + 2);
        ST[E + 2] := ST[0];
      End;
    End;
    Inc(I);
  End;
  ARemoveConsumed;
  { adjectifs devant un nom sans determinant : nom puis adjectifs }
  I := 1;
  While I < SN Do
  Begin
    If (ST[I].Cat = 'A') And ((I = 1) Or Not (ST[I - 1].Cat In ['D', 'S', 'T',
        'Q', 'U', 'A'])) Then
    Begin
      K := I;
      While (K < SN) And (ST[K].Cat = 'A') Do Inc(K);
      If (ST[K].Cat = 'N') And (K - I <= 3) Then
      Begin
        ST[0] := ST[K];
        For J := K Downto I + 1 Do
          ST[J] := ST[J - 1];
        ST[I] := ST[0];
        I := K;
      End
      Else
        I := K;
    End;
    Inc(I);
  End;
  { daar is + groupe nominal indefini : il y a }
  For I := 1 To SN - 2 Do
  Begin
    If (ST[I].Cat = 'R') And (ST[I].W = 'daar') And (ST[I + 1].Cat = 'V') And
       (AfVerbKey(I + 1) = 'ser') And (ST[I + 1].Tns In ['p', 'i']) And
       (ST[I + 2].Cat In ['D', 'N', 'Q', 'U']) And (ST[I + 2].Kind <> 'd') Then
    Begin
      ST[I].Cat := ' ';
      ST[I + 1].Idx := AlSpIndex('haber', 'have');
    End
    Else If (ST[I].Cat = 'V') And (AfVerbKey(I) = 'ser') And (ST[I].Tns In ['p',
        'i']) And
            (ST[I + 1].Cat = 'R') And (ST[I + 1].W = 'daar') And
            (ST[I + 2].Cat In ['D', 'N', 'Q', 'U']) And (ST[I + 2].Kind <> 'd')
                Then
    Begin
      ST[I + 1].Cat := ' ';
      ST[I].Idx := AlSpIndex('haber', 'have');
    End;
  End;
  { inversion : Vandag gaan ek -> Vandag ek gaan ; Praat jy ? -> jy praat ? }
  I := 1;
  While I < SN Do
  Begin
    If (ST[I].Cat = 'V') And (ST[I].Tns In ['p', 'i']) And (Not AfSubjBefore(I))
        Then
    Begin
      E := AfSubjEnd(I + 1);
      If (E > 0) And (E - I <= 8) Then
        If (AfVerbKey(I) <> 'haber') Or (ST[I + 1].Cat = 'P') Then
        Begin
          AfMoveBlock(I + 1, E, I);
          I := E;
        End;
    End;
    Inc(I);
  End;
  { verbe final -> juste apres l'auxiliaire }
  AfFixClauses;
  { negation double : nie ... nie }
  K := 0;
  For I := 1 To SN Do
    If ST[I].Cat = 'G' Then
    Begin
      Inc(K);
      If K > 1 Then ST[I].Cat := ' ';
    End;
  For I := 2 To SN Do
    If (ST[I].Cat = 'G') Then
    Begin
      { avant le premier verbe fini de la proposition }
      J := I - 1;
      While (J >= 1) And (Not (ST[J].Cat In [',', 'C'])) And (Not ((ST[J].Cat =
          'V') And (ST[J].Tns In ['p', 'i']))) Do Dec(J);
      If (J >= 1) And (ST[J].Cat = 'V') And (J < I - 1) Then
      Begin
        ST[0] := ST[I];
        For K := I Downto J + 1 Do
          ST[K] := ST[K - 1];
        ST[J] := ST[0];
      End
      Else If (J >= 1) And (ST[J].Cat = 'V') Then
      Begin
        ST[0] := ST[I];
        ST[I] := ST[J];
        ST[J] := ST[0];
      End;
      Break;
    End;
  { temps composes : het + participe = passe ; sal + verbe = futur }
  For I := 1 To SN - 1 Do
    If ST[I].Cat = 'V' Then
    Begin
      J := I + 1;
      While (J <= SN) And (ST[J].Cat In ['R', 'G', 'P', 'O']) Do Inc(J);
      If (J <= SN) And (ST[J].Cat = 'V') Then
      Begin
        If (ST[I].W = 'het') Or (ST[I].W = 'had') Or
           (((ST[I].W = 'is') Or (ST[I].W = 'was')) And (ST[J].Tns = 'P') And
            InList(ST[J].En, 'go come arrive return leave fall die stay be'))
                Then
        Begin
          If ST[J].Tns = 'P' Then
          Begin
            If (ST[I].W = 'had') Or (ST[I].W = 'was') Then
            Begin
              ST[I].Idx := AlSpIndex('haber', 'have');
              ST[I].En := 'have';
              ST[I].Tns := 'i';
            End
            Else
            Begin
              ST[J].Tns := 'i';
              ST[J].Slot := ST[I].Slot;
              ST[I].Cat := ' ';
            End;
          End;
        End
        Else If ST[I].W = 'sal' Then
        Begin
          ST[J].Tns := 'f';
          ST[J].Slot := ST[I].Slot;
          ST[I].Cat := ' ';
        End
        Else If ST[I].W = 'sou' Then
        Begin
          ST[J].Tns := 'c';
          ST[J].Slot := ST[I].Slot;
          ST[I].Cat := ' ';
        End
        Else If InList(ST[I].W, 'kan wil moet mag kon wou moes') And (ST[J].Tns
            = 'p') Then
          ST[J].Tns := 'I'
        Else If (ST[I].W = 'gaan') And (ST[J].Tns = 'p') And (J = I + 1) Then
          ST[J].Tns := 'I';
      End;
    End;
  ARemoveConsumed;
  { impératif en tete de phrase }
  If (SN >= 1) And (ST[1].Cat = 'V') And (ST[1].Tns = 'p') And (SEnd = '!') Then
  Begin
    ST[1].Tns := 'M';
    ST[1].Slot := 2;
  End;
  { personne du verbe d'apres le sujet qui precede }
  For I := 1 To SN Do
    If (ST[I].Cat = 'V') And (ST[I].Tns In ['p', 'i', 'f', 'c']) Then
    Begin
      ST[I].Slot := 3;
      J := I - 1;
      While (J >= 1) And (ST[J].Cat In ['R', 'G']) Do Dec(J);
      If (J >= 1) And (ST[J].Cat = 'P') Then
        ST[I].Slot := ST[J].Slot
      Else If (J >= 1) And (ST[J].Cat In ['N', 'Z']) Then
      Begin
        If ST[J].Plu And (ST[J].Cat = 'N') Then ST[I].Slot := 6;
        K := J;
        While (K > 1) And (ST[K - 1].Cat In ['D', 'S', 'T', 'Q', 'U', 'A']) Do
            Dec(K);
        If (K > 2) And (ST[K - 1].Cat = 'C') And (ST[K - 1].En = 'and') Then
            ST[I].Slot := 6;
      End;
    End;
  { expressions verbales et cas particuliers }
  For I := 1 To SN Do
    If ST[I].Cat = 'V' Then
    Begin
      Key := AfVerbKey(I);
      If Key = 'haber' Then
      Begin
        ST[I].W := 'hay';
        ST[I].Slot := 3;
      End
      Else If Key = 'llover' Then
        ST[I].Kind := 'g'
      Else If Key = 'llamar' Then
        ST[I].Kind := 'r'
      Else If (ST[I].W = 'hou') And (I < SN) And (ST[I + 1].Cat = 'E') And (ST[I
          + 1].W = 'de') Then
      Begin
        ST[I].Idx := AlSpIndex('af:houvan', 'like');
        ST[I].En := 'like';
        ST[I + 1].Cat := ' ';
      End
      Else If (Key = 'ver') And False Then
        ST[I].Kind := ' ';
      If (ST[I].Idx > 0) And InList(ST[I].W, 'woon') And (AfFirstW = 'donde')
          Then
      Begin
        ST[I].Kind := ' ';
      End;
    End;
  { hoe gaan dit = how are you ; waar is X = ou est X }
  For I := 1 To SN Do
    If (ST[I].Cat = 'V') And (ST[I].W = 'gaan') And (AfFirstW = 'como') Then
      For J := 1 To SN Do
        If (ST[J].Cat = 'P') And (ST[J].W = 'dit') Then
        Begin
          ST[I].Idx := AlSpIndex('estar', 'be');
          ST[I].En := 'be';
          ST[J].En := 'you';
          ST[J].Slot := 2;
          ST[I].Slot := 2;
        End;
  ARemoveConsumed;
  { gaan + infinitif : aller + a + infinitif }
  I := 1;
  While I < SN Do
  Begin
    If (ST[I].Cat = 'V') And (ST[I].W = 'gaan') And (ST[I + 1].Cat = 'V') And
        (ST[I + 1].Tns = 'I') And
       (SN < MaxTokens) Then
    Begin
      ST[I].Idx := AlSpIndex('ir', 'go');
      ST[I].En := 'go';
      AfInsert(I + 1);
      ST[I + 1].Cat := 'E';
      ST[I + 1].W := 'a';
      ST[I + 1].Orig := 'a';
      ST[I + 1].En := 'to';
      Inc(I);
    End;
    Inc(I);
  End;
  { le pluriel de l'article suit celui du nom }
  For I := 1 To SN - 1 Do
    If ST[I].Cat = 'D' Then
    Begin
      K := I + 1;
      While (K < SN) And (ST[K].Cat = 'A') Do Inc(K);
      If ST[K].Cat = 'N' Then ST[I].Plu := ST[K].Plu;
    End;
  { lank : grand pour une personne }
  For I := 3 To SN Do
    If (ST[I].Cat = 'A') And (ST[I].En = 'long') And (ST[I - 1].Cat = 'V') And
       ((ST[I - 2].Cat = 'P') Or ((ST[I - 2].Cat = 'N') And SpIsPersonEn(ST[I -
           2].En))) Then
      ST[I].En := 'tall';
  { complement d'une preposition : pronom de groupe nominal }
  For I := 2 To SN Do
    If (ST[I].Cat = 'O') And (ST[I - 1].Cat = 'E') And (ST[I].En <> '') Then
      ST[I].Cat := 'B';
  { quantificateur pluriel : le nom est au pluriel }
  For I := 1 To SN - 1 Do
    If (ST[I].Cat = 'Q') And ST[I].Plu Then
    Begin
      K := I + 1;
      While (K < SN) And (ST[K].Cat = 'A') Do Inc(K);
      If ST[K].Cat = 'N' Then ST[K].Plu := True;
    End;
  { pronoms complements apres le verbe : enclitiques }
  For I := 2 To SN Do
    If (ST[I].Cat = 'O') And (ST[I - 1].Cat = 'V') And (ST[I].En <> '') Then
    Begin
      ST[I - 1].Cl := ST[I].En;
      ST[I].Cat := ' ';
    End;
  ARemoveConsumed;
End;

Function AfTranslateSentence(Const Sentence: String): String;
Var
  Res: String;
Begin
  AfTokenize(Sentence);
  If SN = 0 Then
  Begin
    AfTranslateSentence := '';
    Exit;
  End;
  AfClassify;
  If SN = 0 Then
  Begin
    AfTranslateSentence := '';
    Exit;
  End;
  Res := TranslateTokensEs(1, SN, SEnd = '?');
  { Hoe heet jy ? -> What is your name ? }
  If (SEnd = '?') And (Length(Res) > 8) And (Copy(Res, Length(Res) - 7, 8) =
      ' name is') Then
    Res := 'What is ' + LowerAscii(Copy(Res, 1, Length(Res) - 8)) + ' name';
  Res := UpperFirst(FixEnglish(Res));
  If SEnd <> #0 Then Res := Res + SEnd;
  AfTranslateSentence := Res;
End;

{ ------------------------------------------------------------------ }
{ ANCIEN FRANCAIS (roman) -> FRANCAIS MODERNE                         }
{ ------------------------------------------------------------------ }
{ Les deux langues sont proches : il s'agit d'une modernisation mot a   }
{ mot (orthographe, formes verbales, articles, contractions), avec le    }
{ systeme a deux cas des noms (li rois = le roi, li roi = les rois), les }
{ accords des adjectifs et des demonstratifs d'apres le nom voisin, et   }
{ l'ajout de "pas" apres "ne". Le vocabulaire integre est limite.       }
{ Les formes inconnues sont conservees telles quelles.                  }

Type
  TFro = Record
    Key: String[24];
    M1, M2: String[28];
    Cat: String[3];
  End;

  TFroTok = Record
    W, Orig: String[34];
    Cap, Punct: Boolean;
    Kind: Char; { N nom, A adjectif, X mot fixe, V verbe, Z nom propre, L li, D
        demonstratif, P ponctuation, E elision }
    Idx: Integer;
    Plu: Boolean;
    Gen: Char;
    HasS: Boolean;
    Fem: Boolean;
    Elide: Boolean;
    FixSg: Boolean;
    Out: String[40];
  End;

Var
  FroLex: Array[1..1100] Of TFro;
  FroCount: Integer;
  SourceFro: Boolean;
  OFT: Array[0..160] Of TFroTok;
  OFN: Integer;

Procedure LoadOldFrench;
Var
  I: Integer;
  Line, Item, Key, Mod1: String;
Begin
  FroCount := 0;
  For I := 0 To High(FroData) Do
  Begin
    Line := FroData[I];
    While Line <> '' Do
    Begin
      Item := CopyUntil(Line, ';');
      If (Item <> '') And (FroCount < 1100) Then
      Begin
        Key := CopyUntil(Item, '=');
        Mod1 := CopyUntil(Item, ':');
        Inc(FroCount);
        FillChar(FroLex[FroCount], SizeOf(TFro), 0);
        FroLex[FroCount].Key := FrLower(Key);
        FroLex[FroCount].M1 := CopyUntil(Mod1, '/');
        FroLex[FroCount].M2 := Mod1;
        FroLex[FroCount].Cat := Item;
      End;
    End;
  End;
End;

{ Premiere entree dont la forme est W et dont la categorie est dans Cats
  (liste de categories separees par des virgules). }
Function FroFind(Const W, Cats: String): Integer;
Var
  I: Integer;
Begin
  FroFind := 0;
  For I := 1 To FroCount Do
    If (FroLex[I].Key = W) And (Pos(',' + FroLex[I].Cat + ',', ',' + Cats + ',')
        > 0) Then
    Begin
      FroFind := I;
      Exit;
    End;
End;

{ Nom : forme exacte, ou avec un -s / -z / -x final (nominatif singulier ou
  pluriel oblique), ou -aus / -eus pour -al / -el. }
Function FroFindNoun(Const W: String; Var HasS: Boolean): Integer;
Var
  I, L: Integer;
Begin
  HasS := False;
  I := FroFind(W, 'nm,nf,ns');
  If I > 0 Then
  Begin
    FroFindNoun := I;
    Exit;
  End;
  L := Length(W);
  If (L > 2) And ((W[L] = 's') Or (W[L] = 'z') Or (W[L] = 'x')) Then
  Begin
    I := FroFind(Copy(W, 1, L - 1), 'nm,nf,ns');
    If I > 0 Then
    Begin
      HasS := True;
      FroFindNoun := I;
      Exit;
    End;
    If (L > 3) And (Copy(W, L - 2, 3) = 'aus') Then I := FroFind(Copy(W, 1, L -
        3) + 'al', 'nm,nf');
    If (I = 0) And (L > 3) And (Copy(W, L - 2, 3) = 'eus') Then I :=
        FroFind(Copy(W, 1, L - 3) + 'el', 'nm,nf');
    If (I = 0) And (L > 3) And (Copy(W, L - 2, 3) = 'ius') Then I :=
        FroFind(Copy(W, 1, L - 3) + 'il', 'nm,nf');
    If I > 0 Then
    Begin
      HasS := True;
      FroFindNoun := I;
      Exit;
    End;
  End;
  FroFindNoun := 0;
End;

Function FroFindAdj(Const W: String; Var HasS: Boolean; Var IsFem: Boolean):
    Integer;
Var
  I, L: Integer;
Begin
  HasS := False;
  IsFem := False;
  I := FroFind(W, 'a');
  If I > 0 Then
  Begin
    FroFindAdj := I;
    Exit;
  End;
  I := FroFind(W, 'af');
  If I > 0 Then
  Begin
    IsFem := True;
    FroFindAdj := I;
    Exit;
  End;
  L := Length(W);
  If (L > 2) And ((W[L] = 's') Or (W[L] = 'z') Or (W[L] = 'x')) Then
  Begin
    I := FroFind(Copy(W, 1, L - 1), 'a');
    If I > 0 Then
    Begin
      HasS := True;
      FroFindAdj := I;
      Exit;
    End;
    I := FroFind(Copy(W, 1, L - 1), 'af');
    If I > 0 Then
    Begin
      HasS := True;
      IsFem := True;
      FroFindAdj := I;
      Exit;
    End;
  End;
  FroFindAdj := 0;
End;

{ ------------------------------------------------------------------ }
{ MALTAIS -> ANGLAIS : lexique de formes, jetons et etiquetage        }
{ ------------------------------------------------------------------ }
{ Le lexique contient des FORMES de surface (les conjugaisons du maltais  }
{ passent par des racines et des voyelles interieures) engendrees a la    }
{ construction : le programme ne fait que chercher la forme. Les jetons   }
{ sont ensuite ceux de l'espagnol (ST), comme pour les autres langues.    }

Type
  TMt = Record
    F1: String[26];
    En: String[26];
    Pos: Char;
    Plu: Boolean;
    Tns, Tns2: Char;
    Slot, Slot2: Integer;
    Num: Boolean;
    SpIdx, SpIdx2: Integer;
  End;

Var
  MtLex: Array[1..1700] Of TMt;
  MtCount: Integer;
  SourceMt: Boolean;

{ minuscules, y compris les lettres maltaises (c point, g point, h barre, z
  point) }
Function MtLower(Const S: String): String;
Var
  R: String;
  I: Integer;
Begin
  R := FrLower(S);
  I := 1;
  While I < Length(R) Do
  Begin
    If (R[I] = #$C4) And (R[I + 1] >= #$80) And (R[I + 1] <= #$BF) And (Not
        Odd(Ord(R[I + 1]))) Then
    Begin
      R[I + 1] := Chr(Ord(R[I + 1]) + 1);
      Inc(I);
    End
    Else If (R[I] = #$C5) And (R[I + 1] = #$BB) Then
    Begin
      R[I + 1] := #$BC;
      Inc(I);
    End;
    Inc(I);
  End;
  MtLower := R;
End;

Procedure MtParseCode(Const Code: String; Var T: Char; Var Slot: Integer; Var
    Key: String);
Begin
  T := ' ';
  Slot := 0;
  Key := '';
  If Length(Code) >= 2 Then
  Begin
    T := Code[1];
    Slot := Ord(Code[2]) - Ord('0');
    If (Length(Code) > 3) And (Code[3] = ':') Then Key := Copy(Code, 4, 12);
  End;
End;

Procedure LoadMaltese;
Var
  I: Integer;
  Line, Item, Key, En, Pos1, Code, Alt1, Alt2, K1, K2: String;
Begin
  MtCount := 0;
  For I := 0 To High(MtData) Do
  Begin
    Line := MtData[I];
    While Line <> '' Do
    Begin
      Item := CopyUntil(Line, ';');
      If (Item <> '') And (MtCount < 1700) Then
      Begin
        Key := CopyUntil(Item, '=');
        En := CopyUntil(Item, ':');
        Pos1 := CopyUntil(Item, ':');
        Code := Item;
        Inc(MtCount);
        FillChar(MtLex[MtCount], SizeOf(TMt), 0);
        MtLex[MtCount].F1 := ReplaceChar(Key, '_', ' ');
        MtLex[MtCount].En := ReplaceChar(En, '_', ' ');
        MtLex[MtCount].Pos := Pos1[1];
        If Pos1[1] = 'v' Then
        Begin
          Alt1 := CopyUntil(Code, '+');
          Alt2 := Code;
          MtParseCode(Alt1, MtLex[MtCount].Tns, MtLex[MtCount].Slot, K1);
          If Alt2 <> '' Then MtParseCode(Alt2, MtLex[MtCount].Tns2,
              MtLex[MtCount].Slot2, K2) Else K2 := K1;
          If K1 <> '' Then MtLex[MtCount].SpIdx := AlSpIndex(K1,
              MtLex[MtCount].En)
          Else MtLex[MtCount].SpIdx := AlSpIndex('mt:' + MtLex[MtCount].En,
              MtLex[MtCount].En);
          MtLex[MtCount].SpIdx2 := MtLex[MtCount].SpIdx;
        End
        Else If Pos1[1] = 'n' Then MtLex[MtCount].Plu := Code = 'p'
        Else If Pos1[1] = 'a' Then MtLex[MtCount].Plu := Code = 'p'
        Else If (Pos1[1] = 's') Then MtLex[MtCount].Slot := Ord(Code[1]) -
            Ord('0')
        Else If (Pos1[1] = 'u') Then MtLex[MtCount].Num := Code = '1';
      End;
    End;
  End;
End;

{ premiere entree de forme W dont la categorie est dans Kinds }
Function MtFind(Const W, Kinds: String): Integer;
Var
  I: Integer;
Begin
  MtFind := 0;
  For I := 1 To MtCount Do
    If (MtLex[I].F1 = W) And (Pos(MtLex[I].Pos, Kinds) > 0) Then
    Begin
      MtFind := I;
      Exit;
    End;
End;

Function MtIsArticle(Const W: String): Boolean;
Begin
  MtIsArticle := InList(W, 'il l id ir it is iz ix in ic');
End;

{ contractions preposition + article : fil-, mill-, bit-... }
Function MtSplitContraction(Const W: String; Var Prep, Art: String): Boolean;
Var
  P, A: String;
  L: Integer;
Begin
  MtSplitContraction := False;
  Prep := '';
  Art := '';
  L := Length(W);
  If L < 3 Then Exit;
  If InList(W, 'fil fit fid fir fis fix fiz fin fic') Then
  Begin
    Prep := 'fi';
    Art := Copy(W, 2, 3);
  End
  Else If InList(W, 'mill mit mid mir mis mix miz') Then
  Begin
    Prep := 'minn';
    Art := Copy(W, 2, 3);
  End
  Else If InList(W, 'bil bit bid bir bis bix biz') Then
  Begin
    Prep := 'bi';
    Art := Copy(W, 2, 3);
  End
  Else If InList(W, 'tal tat tad tar tas tax taz') Then
  Begin
    Prep := 'ta';
    Art := Copy(W, 2, 3);
  End
  Else If InList(W, 'lill lit lid lir lis lix') Then
  Begin
    Prep := 'lil';
    Art := Copy(W, 2, 3);
  End
  Else If InList(W, 'mal mat mad mar mas max') Then
  Begin
    Prep := 'ma''';
    Art := Copy(W, 2, 3);
  End
  Else If W = 'sal' Then
  Begin
    Prep := 'sa';
    Art := 'il';
  End
  Else If W = 'għall' Then
  Begin
    Prep := 'għal';
    Art := 'il';
  End
  Else Exit;
  Art := 'i' + W[Length(W)];
  MtSplitContraction := True;
End;

Procedure MtTokenize(Const S0: String);
Var
  S, Word1, Low, Prep, Art: String;
  I, L: Integer;
  C: Char;
  Cap, Hyph: Boolean;
Begin
  SN := 0;
  SEnd := #0;
  S := '';
  I := 1;
  While I <= Length(S0) Do
  Begin
    If (S0[I] = #$C2) And (I < Length(S0)) And ((S0[I + 1] = #$AB) Or (S0[I + 1]
        = #$BB) Or (S0[I + 1] = #$A0)) Then
    Begin
      S := S + ' ';
      Inc(I, 2);
    End
    Else If (S0[I] = #$E2) And (I + 2 <= Length(S0)) And (S0[I + 1] = #$80) And
            ((S0[I + 2] = #$99) Or (S0[I + 2] = #$98)) Then
    Begin
      S := S + '''';
      Inc(I, 3);
    End
    Else
    Begin
      S := S + S0[I];
      Inc(I);
    End;
  End;
  L := Length(S);
  I := 1;
  While I <= L Do
  Begin
    C := S[I];
    If FrWordByte(C) Then
    Begin
      Word1 := '';
      While (I <= L) And FrWordByte(S[I]) Do
      Begin
        Word1 := Word1 + S[I];
        Inc(I);
      End;
      { apostrophe finale conservee : ma', ta', x' }
      If (I <= L) And (S[I] = '''') And ((I = L) Or (Not FrWordByte(S[I + 1]))
          Or (MtLower(Word1) = 'x') Or
         (MtLower(Word1) = 'ta') Or (MtLower(Word1) = 'ma') Or (MtLower(Word1) =
             'f') Or (MtLower(Word1) = 'b')) Then
      Begin
        Word1 := Word1 + '''';
        Inc(I);
      End;
      Hyph := (I < L) And (S[I] = '-') And FrWordByte(S[I + 1]);
      Cap := (Word1 <> '') And (((Word1[1] >= 'A') And (Word1[1] <= 'Z')) Or
             ((Word1[1] = #$C4) Or (Word1[1] = #$C5)));
      Low := MtLower(Word1);
      { preposition + article : on les separe }
      If Hyph And MtSplitContraction(Low, Prep, Art) Then
      Begin
        SPush(Prep, Prep, False, False, False);
        SPush(Art, Art, False, False, False);
        ST[SN].Cl := 'h';
      End
      Else
      Begin
        SPush(Low, Word1, Cap, False, False);
        If Hyph Then ST[SN].Cl := 'h';
      End;
    End
    Else
    Begin
      If (C = '.') Or (C = '?') Or (C = '!') Then
      Begin
        If SEnd = #0 Then SEnd := C;
        If C = '?' Then SEnd := '?';
      End
      Else If (C = ',') Or (C = ';') Or (C = ':') Then
      Begin
        SPush(',', ',', False, True, False);
        ST[SN].Cat := ',';
      End;
      Inc(I);
    End;
  End;
End;

Procedure MtMergeMultiword;
Var
  I, K, Len, L: Integer;
  Key: String;
  Bad, Found: Boolean;
Begin
  I := 1;
  While I < SN Do
  Begin
    Found := False;
    For Len := 3 Downto 2 Do
      If (Not Found) And (I + Len - 1 <= SN) Then
      Begin
        Key := '';
        Bad := False;
        For K := I To I + Len - 1 Do
        Begin
          If ST[K].Punct Then Bad := True;
          Key := Join(Key, ST[K].W);
        End;
        If Not Bad Then
        Begin
          L := MtFind(Key, 'rpcjw');
          If L > 0 Then
          Begin
            Found := True;
            ST[I].W := Key;
            ST[I].Orig := Key;
            For K := I + 1 To SN - Len + 1 Do
              ST[K] := ST[K + Len - 1];
            Dec(SN, Len - 1);
          End;
        End;
      End;
    Inc(I);
  End;
End;

Function MtNumberEn(Const W: String): String;
Var
  I: Integer;
Begin
  MtNumberEn := '';
  I := MtFind(W, 'u');
  If (I > 0) And MtLex[I].Num Then MtNumberEn := MtLex[I].En;
End;

Procedure MtPickCat(I: Integer);
Var
  W: String;
  Prev: Char;
  Idx: Integer;
Begin
  W := ST[I].W;
  If I > 1 Then Prev := ST[I - 1].Cat Else Prev := '.';
  If ST[I].Punct Then
  Begin
    ST[I].Cat := ',';
    Exit;
  End;
  If IsDigitsOnly(W) Then
  Begin
    ST[I].Cat := 'U';
    ST[I].En := W;
    Exit;
  End;
  { article defini : il-, l-, it-, id-... colle au mot suivant }
  If MtIsArticle(W) And ((ST[I].Cl = 'h') Or (W = 'il') Or (W = 'l')) Then
  Begin
    ST[I].Cat := 'D';
    ST[I].Kind := 'd';
    Exit;
  End;
  { negation verbale : ma ... -x }
  If (W = 'ma') Or (W = 'mhux') Then
  Begin
    ST[I].Cat := 'G';
    Exit;
  End;
  If (W = 'qed') Or (W = 'se') Then
  Begin
    ST[I].Cat := 'y';
    If W = 'qed' Then ST[I].Kind := 'p' Else ST[I].Kind := 'f';
    Exit;
  End;
  If (W = 'lil') Then
  Begin
    ST[I].Cat := 'E';
    ST[I].En := 'to';
    ST[I].W := 'a';
    Exit;
  End;
  { mot lexical, avec -x de la negation retire }
  Idx := MtFind(W, 'wspgqdtcrjuvnazx');
  If (Idx = 0) And (Prev = 'G') And (Length(W) > 2) And (W[Length(W)] = 'x')
      Then
  Begin
    Idx := MtFind(Copy(W, 1, Length(W) - 1), 'v');
    If Idx > 0 Then ST[I].Cl := 'x';
  End;
  If Idx = 0 Then
  Begin
    If ST[I].Cap Then ST[I].Cat := 'Z' Else ST[I].Cat := 'Z';
    Exit;
  End;
  ST[I].En := MtLex[Idx].En;
  Case MtLex[Idx].Pos Of
    'w':
    Begin
      ST[I].Cat := 'W';
      If W = 'fejn' Then ST[I].W := 'donde'
      Else If W = 'min' Then ST[I].W := 'quien'
      Else If W = 'meta' Then ST[I].W := 'cuando'
      Else If (W = 'kif') Then ST[I].W := 'como'
      Else If W = 'liema' Then ST[I].W := 'cual'
      Else If W = 'kemm' Then ST[I].W := 'cuantos'
      Else If (W = 'għaliex') Or (W = 'ghaliex') Then ST[I].W := 'por que'
      Else ST[I].W := 'que';
    End;
    's':
    Begin
      ST[I].Cat := 'P';
      ST[I].Slot := MtLex[Idx].Slot;
    End;
    'p':
    Begin
      ST[I].Cat := 'E';
      If (W = 'fi') Or (W = 'f''') Or (W = 'fuq') Or (W = 'b''') Or (W = 'bi')
          Then ST[I].W := 'en'
      Else If (W = 'ta''') Or (W = 'ta') Then ST[I].W := 'de'
      Else If W = 'minn' Then ST[I].W := 'desde'
      Else If W = 'għal' Then ST[I].W := 'para'
      Else If W = 'mingħajr' Then ST[I].W := 'sin';
    End;
    'g': ST[I].Cat := 'G';
    'q':
    Begin
      ST[I].Cat := 'g';
    End;
    'd':
    Begin
      ST[I].Cat := 'T';
      ST[I].Plu := (W = 'dawn') Or (W = 'dawk');
      If ST[I].Plu Then
      Begin
        If (W = 'dawn') Then ST[I].En := 'these' Else ST[I].En := 'those';
      End
      Else If (W = 'dan') Or (W = 'din') Then ST[I].En := 'this' Else ST[I].En
          := 'that';
    End;
    'x':
    Begin
      ST[I].Cat := 'S';
      ST[I].Kind := 'x';
    End;
    'c': ST[I].Cat := 'C';
    'r': ST[I].Cat := 'R';
    'j': ST[I].Cat := 'J';
    'u':
    Begin
      If MtLex[Idx].Num Then ST[I].Cat := 'U' Else ST[I].Cat := 'Q';
      If (ST[I].Cat = 'Q') Then ST[I].Plu := InList(W, 'kollha ħafna ftit');
    End;
    't':
    Begin
      ST[I].Cat := 'Z';
      ST[I].Orig := ST[I].En;
    End;
    'z':
    Begin
      ST[I].Cat := 'Z';
      ST[I].Orig := ST[I].En;
      ST[I].Cap := True;
    End;
    'v':
    Begin
      ST[I].Cat := 'V';
      ST[I].Idx := MtLex[Idx].SpIdx;
      ST[I].Tns := MtLex[Idx].Tns;
      ST[I].Slot := MtLex[Idx].Slot;
      ST[I].Kind := ' ';
      If MtLex[Idx].Tns2 <> ' ' Then
      Begin
        ST[I].Cl := '';
        If MtLex[Idx].Slot2 > 0 Then ST[I].Kind := Chr(Ord('0') +
            MtLex[Idx].Slot2);
      End;
    End;
    'n':
    Begin
      ST[I].Cat := 'N';
      ST[I].Plu := MtLex[Idx].Plu;
    End;
    'a':
    Begin
      ST[I].Cat := 'A';
      ST[I].Plu := MtLex[Idx].Plu;
    End;
  End;
End;

