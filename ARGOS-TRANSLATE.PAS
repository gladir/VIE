Function GPhraseKey(A, B: Integer): String;
Var
  K: Integer;
  R: String;
Begin
  R := '';
  For K := A To B Do
  Begin
    If GT[K].Punct Then
    Begin
      GPhraseKey := '#';
      Exit;
    End;
    R := Join(R, GT[K].W);
  End;
  GPhraseKey := R;
End;

Function FindPhraseDe(Const Key: String): String;
Var
  N: Integer;
  Pair, K: String;
Begin
  FindPhraseDe := '';
  If Key = '#' Then Exit;
  For N := 0 To High(PhrasesDeIn) Do
  Begin
    Pair := PhrasesDeIn[N];
    K := CopyUntil(Pair, '|');
    If K = Key Then
    Begin
      FindPhraseDe := Pair;
      Exit;
    End;
  End;
End;


