Procedure DecodeError(Reason: String);
Begin
  ClearProgress;
  Writeln('Erreur : ', Reason);
  Halt(2);
End;

Function ReadBin: Integer;
Begin
  If InPos >= InLen Then
  Begin
    {$I-}
    BlockRead(BinFile, InBuf, SizeOf(InBuf), InLen);
    {$I+}
    If IOResult <> 0 Then InLen := 0;
    InPos := 0;
    If InLen = 0 Then
    Begin
      ReadBin := -1;
      Exit;
    End;
  End;
  ReadBin := InBuf[InPos];
  Inc(InPos);
  Inc(BinPosition);
End;

Function NeedByte: Byte;
Var
  Value: Integer;
Begin
  Value := ReadBin;
  If Value < 0 Then DecodeError('fin de fichier image inattendue.');
  NeedByte := Value;
End;

Procedure SkipBytes(Count: Longint);
Var
  Dummy: Byte;
Begin
  While Count > 0 Do
  Begin
    Dummy := NeedByte;
    Dec(Count);
  End;
End;

Function ReadBE16: Integer;
Var
  High: Integer;
Begin
  High := NeedByte;
  ReadBE16 := High * 256 + NeedByte;
End;

Function ReadBE32: Longint;
Var
  Value: Longint;
  I: Integer;
Begin
  Value := 0;
  For I := 1 To 4 Do
    Value := (Value Shl 8) Or NeedByte;
  ReadBE32 := Value;
End;

Function ReadLE32: Longint;
Var
  Value: Longint;
  I: Integer;
Begin
  Value := 0;
  For I := 0 To 3 Do
    Value := Value Or (Longint(NeedByte) Shl (8 * I));
  ReadLE32 := Value;
End;

Function ReadLE16: Integer;
Var
  Low: Integer;
Begin
  Low := NeedByte;
  ReadLE16 := Low + NeedByte * 256;
End;

Function GrayOf(Red, Green, Blue: Integer): Integer;
Begin
  GrayOf := (77 * Longint(Red) + 150 * Longint(Green) + 29 * Longint(Blue)) Div 256;
End;

{ Memoire de tas disponible (Turbo Pascal) ; Free Pascal alloue a la demande. }
Function AvailableMemory: Longint;
Begin
{$IFDEF FPC}
  AvailableMemory := MaxLongint;
{$ELSE}
  AvailableMemory := MaxAvail;
{$ENDIF}
End;

Procedure SetImageSize(NewWidth, NewHeight: Longint);
Var
  Row: Integer;
Begin
  If (NewWidth < 1) Or (NewWidth > MaxImageWidth) Then
    DecodeError('largeur invalide (maximum 32000 pixels).');
  If (NewHeight < 1) Or (NewHeight > MaxImageHeight) Then
    DecodeError('hauteur invalide (maximum 16000 pixels).');
  If NewWidth * NewHeight > 67108864 Then DecodeError('image trop grande.');
  If Image <> Nil Then DecodeError('en-tete d''image en double.');
  ImageWidth := NewWidth;
  ImageHeight := NewHeight;
  If AvailableMemory < NewHeight * SizeOf(PImageRow) Then
    DecodeError('memoire insuffisante pour l''image.');
  GetMem(Image, Word(NewHeight * SizeOf(PImageRow)));
  For Row := 1 To ImageHeight Do
  Begin
    If AvailableMemory < NewWidth Then
      DecodeError('memoire insuffisante pour l''image.');
    GetMem(Image^[Row], Word(NewWidth));
    FillChar(Image^[Row]^, Word(NewWidth), 255);
  End;
End;

{ Le pixel est fusionne sur du blanc selon son opacite, puis garde en niveau de gris. }
Procedure PutPixel(PixelX, PixelY, Gray, Alpha: Integer);
Begin
  If (PixelX < 1) Or (PixelX > ImageWidth) Or
     (PixelY < 1) Or (PixelY > ImageHeight) Then Exit;
  If Alpha < 255 Then
    Gray := (Longint(Gray) * Alpha + 255 * Longint(255 - Alpha)) Div 255;
  If Gray < 0 Then Gray := 0;
  If Gray > 255 Then Gray := 255;
  Image^[PixelY]^[PixelX] := Gray;
End;

Function DetectFormat: Integer;
Var
  Signature: Array[0..7] Of Integer;
  I: Integer;
Begin
  Assign(BinFile, ImageName);
  {$I-}
  Reset(BinFile, 1);
  {$I+}
  If IOResult <> 0 Then DecodeError('impossible de lire le fichier image.');
  InPos := 0;
  InLen := 0;
  For I := 0 To 7 Do
    Signature[I] := ReadBin;

  DetectFormat := FormatPbm;
  If (Signature[0] = $89) And (Signature[1] = $50) And
     (Signature[2] = $4E) And (Signature[3] = $47) Then
    DetectFormat := FormatPng
  Else If (Signature[0] = $FF) And (Signature[1] = $D8) Then
    DetectFormat := FormatJpeg
  Else If (Signature[0] = Ord('G')) And (Signature[1] = Ord('I')) And
          (Signature[2] = Ord('F')) Then
    DetectFormat := FormatGif
  Else If (Signature[0] = Ord('B')) And (Signature[1] = Ord('M')) Then
    DetectFormat := FormatBmp;

  Seek(BinFile, 0);
  InPos := 0;
  InLen := 0;
  BinPosition := 0;
End;

{ ------------------------------------------------------------------ }
{ PNG : decompression DEFLATE (zlib) puis defiltrage des lignes       }
{ ------------------------------------------------------------------ }

Procedure PngBeginPass;
Begin
  While True Do
  Begin
    If PngInterlace = 0 Then
    Begin
      If PngPass > 0 Then
      Begin
        PngDone := True;
        Exit;
      End;
      PngStartX := 0;
      PngStartY := 0;
      PngStepX := 1;
      PngStepY := 1;
    End
    Else
    Begin
      If PngPass > 6 Then
      Begin
        PngDone := True;
        Exit;
      End;
      PngStartX := AdamStartX[PngPass];
      PngStartY := AdamStartY[PngPass];
      PngStepX := AdamStepX[PngPass];
      PngStepY := AdamStepY[PngPass];
    End;
    PngPassWidth := (PngWidth - PngStartX + PngStepX - 1) Div PngStepX;
    PngPassHeight := (PngHeight - PngStartY + PngStepY - 1) Div PngStepY;
    If (PngPassWidth > 0) And (PngPassHeight > 0) Then
    Begin
      PngRowBytes := (Longint(PngPassWidth) * PngDepth * PngChannels + 7) Div 8;
      FillChar(PngPrevious^, PngRowBytes + 1, 0);
      PngRow := 0;
      PngRowFill := 0;
      Exit;
    End;
    Inc(PngPass);
  End;
End;

Function PngSample(PixelIndex, Channel: Integer): Integer;
Var
  Position: Longint;
  Shift: Integer;
Begin
  If PngDepth = 8 Then
    PngSample := PngCurrent^[Word(1 + Longint(PixelIndex) * PngChannels + Channel)]
  Else If PngDepth = 16 Then
    PngSample := PngCurrent^[Word(1 + (Longint(PixelIndex) * PngChannels + Channel) * 2)]
  Else
  Begin
    Position := Longint(PixelIndex) * PngDepth;
    Shift := 8 - PngDepth - Integer(Position And 7);
    PngSample := (PngCurrent^[Word(1 + Position Shr 3)] Shr Shift) And
                 ((1 Shl PngDepth) - 1);
  End;
End;

Procedure PngProcessRow;
Var
  I: Word;
  A, B, C, P, PA, PB, PC, V: Integer;
  Px, Gray, Alpha, Index: Integer;
Begin
  If PngCurrent^[0] > 4 Then DecodeError('filtre PNG invalide.');
  For I := 1 To PngRowBytes Do
  Begin
    If I > PngBpp Then
    Begin
      A := PngCurrent^[I - PngBpp];
      C := PngPrevious^[I - PngBpp];
    End
    Else
    Begin
      A := 0;
      C := 0;
    End;
    B := PngPrevious^[I];
    Case PngCurrent^[0] Of
      1: V := A;
      2: V := B;
      3: V := (A + B) Div 2;
      4:
      Begin
        P := A + B - C;
        PA := Abs(P - A);
        PB := Abs(P - B);
        PC := Abs(P - C);
        If (PA <= PB) And (PA <= PC) Then
          V := A
        Else If PB <= PC Then
          V := B
        Else
          V := C;
      End;
    Else
      V := 0;
    End;
    PngCurrent^[I] := (PngCurrent^[I] + V) And $FF;
  End;

  For Px := 0 To PngPassWidth - 1 Do
  Begin
    Alpha := 255;
    Case PngColor Of
      0:
      Begin
        Gray := PngSample(Px, 0);
        If PngDepth < 8 Then
          Gray := Gray * 255 Div ((1 Shl PngDepth) - 1);
      End;
      2: Gray := GrayOf(PngSample(Px, 0), PngSample(Px, 1), PngSample(Px, 2));
      3:
      Begin
        Index := PngSample(Px, 0);
        Gray := GrayOf(Palette[Index * 3], Palette[Index * 3 + 1],
                       Palette[Index * 3 + 2]);
        Alpha := PaletteAlpha[Index];
      End;
      4:
      Begin
        Gray := PngSample(Px, 0);
        Alpha := PngSample(Px, 1);
      End;
    Else
      Gray := GrayOf(PngSample(Px, 0), PngSample(Px, 1), PngSample(Px, 2));
      Alpha := PngSample(Px, 3);
    End;
    PutPixel(PngStartX + Px * PngStepX + 1, PngStartY + PngRow * PngStepY + 1,
             Gray, Alpha);
  End;

  Move(PngCurrent^, PngPrevious^, PngRowBytes + 1);
  Inc(PngRow);
  PngRowFill := 0;
  If PngRow >= PngPassHeight Then
  Begin
    Inc(PngPass);
    PngBeginPass;
  End;
End;

Procedure PngOutByte(Value: Byte);
Begin
  If PngDone Then Exit;
  PngCurrent^[PngRowFill] := Value;
  Inc(PngRowFill);
  If PngRowFill > PngRowBytes Then PngProcessRow;
End;

Procedure EmitByte(Value: Byte);
Begin
  InflateWindow^[WindowPos] := Value;
  WindowPos := (WindowPos + 1) And $7FFF;
  PngOutByte(Value);
End;

{ Octet suivant du flux compresse, repartis dans les blocs IDAT. }
Function InflateByte: Integer;
Begin
  While IdatLeft = 0 Do
  Begin
    SkipBytes(4);
    IdatLeft := ReadBE32;
    If ReadBE32 <> $49444154 Then
      DecodeError('donnees de pixels PNG incompletes.');
  End;
  Dec(IdatLeft);
  InflateByte := NeedByte;
End;

Function GetBits(Count: Integer): Longint;
Begin
  While BitCount < Count Do
  Begin
    BitBuffer := BitBuffer Or (Longint(InflateByte) Shl BitCount);
    Inc(BitCount, 8);
  End;
  GetBits := BitBuffer And ((Longint(1) Shl Count) - 1);
  BitBuffer := BitBuffer Shr Count;
  Dec(BitCount, Count);
End;

Function DecodeSymbol(Var Table: THuffman): Integer;
Var
  Len: Integer;
  Code, First, Index, Count: Longint;
Begin
  DecodeSymbol := 0;
  Code := 0;
  First := 0;
  Index := 0;
  For Len := 1 To 15 Do
  Begin
    Code := Code Or GetBits(1);
    Count := Table.Count[Len];
    If Code - Count < First Then
    Begin
      Index := Index + (Code - First);
      If (Index < 0) Or (Index > 287) Then
        DecodeError('code de Huffman PNG invalide.');
      DecodeSymbol := Table.Symbol[Index];
      Exit;
    End;
    Index := Index + Count;
    First := (First + Count) Shl 1;
    Code := Code Shl 1;
  End;
  DecodeError('code de Huffman PNG invalide.');
End;

Procedure BuildHuffman(Var Table: THuffman; Start, Number: Integer);
Var
  Offsets: Array[0..15] Of Integer;
  I, Len: Integer;
Begin
  FillChar(Table.Count, SizeOf(Table.Count), 0);
  For I := 0 To Number - 1 Do
    Inc(Table.Count[CodeLengths[Start + I]]);
  Offsets[0] := 0;
  Offsets[1] := 0;
  For I := 1 To 14 Do
    Offsets[I + 1] := Offsets[I] + Table.Count[I];
  For I := 0 To Number - 1 Do
  Begin
    Len := CodeLengths[Start + I];
    If Len <> 0 Then
    Begin
      If Offsets[Len] > 287 Then DecodeError('table de Huffman PNG invalide.');
      Table.Symbol[Offsets[Len]] := I;
      Inc(Offsets[Len]);
    End;
  End;
End;

Procedure InflateCodes;
Var
  Symbol, Len, I: Integer;
  Distance: Longint;
Begin
  While True Do
  Begin
    Symbol := DecodeSymbol(LiteralTable);
    If Symbol < 256 Then
      EmitByte(Symbol)
    Else If Symbol = 256 Then
      Exit
    Else
    Begin
      Dec(Symbol, 257);
      If Symbol >= 29 Then DecodeError('symbole DEFLATE invalide.');
      Len := LengthBase[Symbol] + Integer(GetBits(LengthExtra[Symbol]));
      Symbol := DecodeSymbol(DistanceTable);
      If Symbol >= 30 Then DecodeError('distance DEFLATE invalide.');
      Distance := DistanceBase[Symbol] + GetBits(DistanceExtra[Symbol]);
      For I := 1 To Len Do
        EmitByte(InflateWindow^[Word((Longint(WindowPos) - Distance) And $7FFF)]);
    End;
  End;
End;

Procedure BuildFixedTables;
Var
  I: Integer;
Begin
  For I := 0 To 143 Do CodeLengths[I] := 8;
  For I := 144 To 255 Do CodeLengths[I] := 9;
  For I := 256 To 279 Do CodeLengths[I] := 7;
  For I := 280 To 287 Do CodeLengths[I] := 8;
  BuildHuffman(LiteralTable, 0, 288);
  For I := 0 To 29 Do CodeLengths[I] := 5;
  BuildHuffman(DistanceTable, 0, 30);
End;

Procedure BuildDynamicTables;
Var
  LiteralCount, DistanceCount, CodeCount, I, Index, Symbol, Repeats: Integer;
  Previous: Byte;
Begin
  LiteralCount := GetBits(5) + 257;
  DistanceCount := GetBits(5) + 1;
  CodeCount := GetBits(4) + 4;
  If (LiteralCount > 286) Or (DistanceCount > 30) Then
    DecodeError('bloc DEFLATE invalide.');
  FillChar(CodeLengths, SizeOf(CodeLengths), 0);
  For I := 0 To CodeCount - 1 Do
    CodeLengths[CodeLengthOrder[I]] := GetBits(3);
  BuildHuffman(LiteralTable, 0, 19);

  Index := 0;
  While Index < LiteralCount + DistanceCount Do
  Begin
    Symbol := DecodeSymbol(LiteralTable);
    If Symbol < 16 Then
    Begin
      CodeLengths[Index] := Symbol;
      Inc(Index);
    End
    Else
    Begin
      Previous := 0;
      If Symbol = 16 Then
      Begin
        If Index = 0 Then DecodeError('bloc DEFLATE invalide.');
        Previous := CodeLengths[Index - 1];
        Repeats := 3 + GetBits(2);
      End
      Else If Symbol = 17 Then
        Repeats := 3 + GetBits(3)
      Else
        Repeats := 11 + GetBits(7);
      If Index + Repeats > LiteralCount + DistanceCount Then
        DecodeError('bloc DEFLATE invalide.');
      While Repeats > 0 Do
      Begin
        CodeLengths[Index] := Previous;
        Inc(Index);
        Dec(Repeats);
      End;
    End;
  End;
  BuildHuffman(LiteralTable, 0, LiteralCount);
  BuildHuffman(DistanceTable, LiteralCount, DistanceCount);
End;

Procedure InflateStream;
Var
  Last, BlockType, Header: Integer;
  Len, Complement: Longint;
Begin
  BitBuffer := 0;
  BitCount := 0;
  Header := InflateByte;
  If (Header And 15) <> 8 Then DecodeError('compression PNG non prise en charge.');
  If (InflateByte And $20) <> 0 Then
    DecodeError('dictionnaire zlib PNG non pris en charge.');
  Repeat
    Last := GetBits(1);
    BlockType := GetBits(2);
    If BlockType = 0 Then
    Begin
      BitBuffer := 0;
      BitCount := 0;
      Len := InflateByte;
      Len := Len + InflateByte * 256;
      Complement := InflateByte;
      Complement := Complement + InflateByte * 256;
      If Len <> (Complement Xor $FFFF) Then
        DecodeError('bloc DEFLATE invalide.');
      While Len > 0 Do
      Begin
        EmitByte(InflateByte);
        Dec(Len);
      End;
    End
    Else If BlockType = 1 Then
    Begin
      BuildFixedTables;
      InflateCodes;
    End
    Else If BlockType = 2 Then
    Begin
      BuildDynamicTables;
      InflateCodes;
    End
    Else
      DecodeError('bloc DEFLATE invalide.');
  Until (Last = 1) Or PngDone;
End;

Procedure LoadPng;
Var
  I, Value: Integer;
  ChunkLength, ChunkType: Longint;
  GotHeader: Boolean;
Begin
  SkipBytes(8);
  GotHeader := False;
  FillChar(Palette, SizeOf(Palette), 0);
  FillChar(PaletteAlpha, SizeOf(PaletteAlpha), 255);
  While True Do
  Begin
    ChunkLength := ReadBE32;
    ChunkType := ReadBE32;
    If ChunkLength < 0 Then DecodeError('bloc PNG invalide.');
    If ChunkType = $49484452 Then { IHDR }
    Begin
      If ChunkLength < 13 Then DecodeError('en-tete PNG invalide.');
      PngWidth := ReadBE32;
      PngHeight := ReadBE32;
      SetImageSize(PngWidth, PngHeight);
      PngDepth := NeedByte;
      PngColor := NeedByte;
      If (NeedByte <> 0) Or (NeedByte <> 0) Then
        DecodeError('methode de compression PNG non prise en charge.');
      PngInterlace := NeedByte;
      If PngInterlace > 1 Then DecodeError('entrelacement PNG invalide.');
      Case PngColor Of
        0: PngChannels := 1;
        2: PngChannels := 3;
        3: PngChannels := 1;
        4: PngChannels := 2;
        6: PngChannels := 4;
      Else
        DecodeError('type de couleur PNG invalide.');
      End;
      If Not (PngDepth In [1, 2, 4, 8, 16]) Then
        DecodeError('profondeur PNG invalide.');
      If (PngColor In [2, 4, 6]) And (PngDepth < 8) Then
        DecodeError('profondeur PNG invalide.');
      If (PngColor = 3) And (PngDepth = 16) Then
        DecodeError('profondeur PNG invalide.');
      PngBpp := (PngDepth * PngChannels + 7) Div 8;
      If (Longint(PngWidth) * PngDepth * PngChannels + 7) Div 8 + 1 > 65520 Then
        DecodeError('image PNG trop large pour la memoire disponible.');
      If AvailableMemory < 2 * Longint(65520) Then
        DecodeError('memoire insuffisante pour l''image.');
      GetMem(PngCurrent, Word((Longint(PngWidth) * PngDepth * PngChannels + 7) Div 8 + 1));
      GetMem(PngPrevious, Word((Longint(PngWidth) * PngDepth * PngChannels + 7) Div 8 + 1));
      GotHeader := True;
      SkipBytes(ChunkLength - 13 + 4);
    End
    Else If ChunkType = $504C5445 Then { PLTE }
    Begin
      For I := 0 To ChunkLength - 1 Do
      Begin
        Value := NeedByte;
        If I < 768 Then Palette[I] := Value;
      End;
      SkipBytes(4);
    End
    Else If ChunkType = $74524E53 Then { tRNS }
    Begin
      If GotHeader And (PngColor = 3) Then
      Begin
        For I := 0 To ChunkLength - 1 Do
        Begin
          Value := NeedByte;
          If I < 256 Then PaletteAlpha[I] := Value;
        End;
        SkipBytes(4);
      End
      Else
        SkipBytes(ChunkLength + 4);
    End
    Else If ChunkType = $49444154 Then { IDAT }
    Begin
      If Not GotHeader Then DecodeError('en-tete PNG manquant.');
      IdatLeft := ChunkLength;
      GetMem(InflateWindow, SizeOf(TWindow));
      FillChar(InflateWindow^, SizeOf(TWindow), 0);
      WindowPos := 0;
      PngPass := 0;
      PngDone := False;
      PngBeginPass;
      InflateStream;
      If Not PngDone Then DecodeError('donnees de pixels PNG incompletes.');
      FreeMem(InflateWindow, SizeOf(TWindow));
      Exit;
    End
    Else If ChunkType = $49454E44 Then { IEND }
      DecodeError('donnees d image PNG absentes.')
    Else
      SkipBytes(ChunkLength + 4);
  End;
End;

{ ------------------------------------------------------------------ }
{ JPEG : decodage Huffman + DCT inverse de la luminance (Y) seulement }
{ ------------------------------------------------------------------ }

Function JpegNextMarker: Integer;
Var
  Value: Integer;
Begin
  If JpegMarker <> 0 Then
  Begin
    JpegNextMarker := JpegMarker;
    JpegMarker := 0;
    Exit;
  End;
  While True Do
  Begin
    Repeat
      Value := NeedByte;
    Until Value = $FF;
    Repeat
      Value := NeedByte;
    Until Value <> $FF;
    If Value <> 0 Then
    Begin
      JpegNextMarker := Value;
      Exit;
    End;
  End;
End;

Function JpegGetBit: Integer;
Var
  Value, Second: Integer;
Begin
  If JpegBitCount = 0 Then
  Begin
    If JpegMarker <> 0 Then
      Value := 0
    Else
    Begin
      Value := NeedByte;
      If Value = $FF Then
      Begin
        Second := NeedByte;
        While Second = $FF Do
          Second := NeedByte;
        If Second <> 0 Then
        Begin
          JpegMarker := Second;
          Value := 0;
        End;
      End;
    End;
    JpegBitBuffer := Value;
    JpegBitCount := 8;
  End;
  Dec(JpegBitCount);
  JpegGetBit := (JpegBitBuffer Shr JpegBitCount) And 1;
End;

Function JpegReceive(Count: Integer): Longint;
Var
  Value: Longint;
  I: Integer;
Begin
  Value := 0;
  For I := 1 To Count Do
    Value := (Value Shl 1) Or JpegGetBit;
  JpegReceive := Value;
End;

Function JpegExtend(Value: Longint; Count: Integer): Longint;
Begin
  If Count = 0 Then
    JpegExtend := 0
  Else If Value < (Longint(1) Shl (Count - 1)) Then
    JpegExtend := Value - (Longint(1) Shl Count) + 1
  Else
    JpegExtend := Value;
End;

Function JpegDecode(Var Table: TJpegHuffman): Integer;
Var
  Len: Integer;
  Code: Longint;
Begin
  Code := 0;
  For Len := 1 To 16 Do
  Begin
    Code := (Code Shl 1) Or JpegGetBit;
    If Code <= Table.MaxCode[Len] Then
    Begin
      JpegDecode := Table.Values[Integer((Table.ValPtr[Len] + Code - Table.MinCode[Len]) And 255)];
      Exit;
    End;
  End;
  DecodeError('code de Huffman JPEG invalide.');
  JpegDecode := 0;
End;

Procedure JpegReadTables(Marker: Integer);
Var
  Remaining, Info, Precision, Index, Total, K, Len: Integer;
  Code: Longint;
  Counts: Array[1..16] Of Byte;
  SegmentLength: Integer;
Begin
  SegmentLength := ReadBE16;
  Remaining := SegmentLength - 2;
  If Marker = $DD Then
  Begin
    JpegRestart := ReadBE16;
    Exit;
  End;
  While Remaining > 0 Do
  Begin
    Info := NeedByte;
    If Marker = $DB Then
    Begin
      Precision := Info Shr 4;
      Index := Info And 15;
      If (Index > 3) Or (Precision > 1) Then DecodeError('table de quantification JPEG invalide.');
      For K := 0 To 63 Do
        If Precision = 0 Then
          JpegQuant[Index, K] := NeedByte
        Else
          JpegQuant[Index, K] := ReadBE16;
      Dec(Remaining, 1 + 64 * (Precision + 1));
    End
    Else
    Begin
      Index := (Info Shr 4) * 2 + (Info And 15);
      If ((Info Shr 4) > 1) Or ((Info And 15) > 1) Then
        DecodeError('table de Huffman JPEG invalide.');
      Total := 0;
      For K := 1 To 16 Do
      Begin
        Counts[K] := NeedByte;
        Inc(Total, Counts[K]);
      End;
      If Total > 256 Then DecodeError('table de Huffman JPEG invalide.');
      FillChar(JpegHuffman[Index].Values, 256, 0);
      For K := 0 To Total - 1 Do
        JpegHuffman[Index].Values[K] := NeedByte;
      Code := 0;
      K := 0;
      For Len := 1 To 16 Do
      Begin
        JpegHuffman[Index].ValPtr[Len] := K;
        JpegHuffman[Index].MinCode[Len] := Code;
        Inc(Code, Counts[Len]);
        Inc(K, Counts[Len]);
        If Counts[Len] > 0 Then
          JpegHuffman[Index].MaxCode[Len] := Code - 1
        Else
          JpegHuffman[Index].MaxCode[Len] := -1;
        Code := Code Shl 1;
      End;
      JpegHuffman[Index].Defined := True;
      Dec(Remaining, 17 + Total);
    End;
  End;
End;

Procedure JpegReadFrame;
Var
  SegmentLength, I, Info, Count: Integer;
  NewWidth, NewHeight: Integer;
Begin
  SegmentLength := ReadBE16;
  If NeedByte <> 8 Then DecodeError('precision JPEG non prise en charge.');
  NewHeight := ReadBE16;
  NewWidth := ReadBE16;
  SetImageSize(NewWidth, NewHeight);
  Count := NeedByte;
  If (Count <> 1) And (Count <> 3) Then
    DecodeError('nombre de composantes JPEG non pris en charge.');
  JpegComponentCount := Count;
  JpegHMax := 1;
  JpegVMax := 1;
  For I := 1 To Count Do
  Begin
    JpegComponent[I].Id := NeedByte;
    Info := NeedByte;
    JpegComponent[I].H := Info Shr 4;
    JpegComponent[I].V := Info And 15;
    JpegComponent[I].Tq := NeedByte;
    If (JpegComponent[I].H < 1) Or (JpegComponent[I].H > 4) Or
       (JpegComponent[I].V < 1) Or (JpegComponent[I].V > 4) Or
       (JpegComponent[I].Tq > 3) Then
      DecodeError('composante JPEG invalide.');
    If JpegComponent[I].H > JpegHMax Then JpegHMax := JpegComponent[I].H;
    If JpegComponent[I].V > JpegVMax Then JpegVMax := JpegComponent[I].V;
  End;
  SkipBytes(SegmentLength - 8 - 3 * Count);
  If (JpegComponent[1].H <> JpegHMax) Or (JpegComponent[1].V <> JpegVMax) Then
    DecodeError('echantillonnage JPEG non pris en charge.');
  JpegFrameSeen := True;
End;

{ DCT inverse separable ; ecrit les 8 x 8 pixels du bloc dans l'image. }
Procedure JpegStoreBlock(OriginX, OriginY: Integer);
Var
  Temp: Array[0..7, 0..7] Of Real;
  U, V, X, Y: Integer;
  Sum: Real;
  Value: Longint;
Begin
  For V := 0 To 7 Do
    For X := 0 To 7 Do
    Begin
      Sum := 0;
      For U := 0 To 7 Do
        Sum := Sum + JpegCosine[X, U] * JpegBlock[V * 8 + U];
      Temp[V, X] := Sum;
    End;
  For Y := 0 To 7 Do
    For X := 0 To 7 Do
    Begin
      Sum := 0;
      For V := 0 To 7 Do
        Sum := Sum + JpegCosine[Y, V] * Temp[V, X];
      Value := Round(Sum) + 128;
      If Value < 0 Then Value := 0;
      If Value > 255 Then Value := 255;
      PutPixel(OriginX + X + 1, OriginY + Y + 1, Value, 255);
    End;
End;

Procedure JpegDecodeBlock(Index: Integer);
Var
  Size, K, Symbol, Run: Integer;
  Table: Integer;
Begin
  FillChar(JpegBlock, SizeOf(JpegBlock), 0);
  Table := JpegComponent[Index].Tq;
  Size := JpegDecode(JpegHuffman[JpegComponent[Index].Td]);
  If Size > 11 Then DecodeError('donnees JPEG invalides.');
  Inc(JpegComponent[Index].Pred, JpegExtend(JpegReceive(Size), Size));
  JpegBlock[0] := JpegComponent[Index].Pred * JpegQuant[Table, 0];
  K := 1;
  While K < 64 Do
  Begin
    Symbol := JpegDecode(JpegHuffman[2 + JpegComponent[Index].Ta]);
    Run := Symbol Shr 4;
    Size := Symbol And 15;
    If Size = 0 Then
    Begin
      If Run = 15 Then
        Inc(K, 16)
      Else
        Break;
    End
    Else
    Begin
      Inc(K, Run);
      If K > 63 Then Break;
      JpegBlock[ZigZag[K]] := JpegExtend(JpegReceive(Size), Size) *
                              JpegQuant[Table, K];
      Inc(K);
    End;
  End;
End;

Procedure JpegReadScan;
Var
  SegmentLength, ScanCount, I, J, Selector, Info: Integer;
  ScanList: Array[1..3] Of Integer;
  Interleaved: Boolean;
  McuAcross, McuDown, McuIndex, McuTotal: Longint;
  McuX, McuY, BlockH, BlockV, Comp: Integer;
  Marker: Integer;
Begin
  If Not JpegFrameSeen Then DecodeError('en-tete JPEG manquant.');
  SegmentLength := ReadBE16;
  ScanCount := NeedByte;
  If (ScanCount < 1) Or (ScanCount > JpegComponentCount) Then
    DecodeError('balayage JPEG invalide.');
  For I := 1 To ScanCount Do
  Begin
    Selector := NeedByte;
    Info := NeedByte;
    ScanList[I] := 0;
    For J := 1 To JpegComponentCount Do
      If JpegComponent[J].Id = Selector Then ScanList[I] := J;
    If ScanList[I] = 0 Then DecodeError('composante JPEG inconnue.');
    JpegComponent[ScanList[I]].Td := Info Shr 4;
    JpegComponent[ScanList[I]].Ta := Info And 15;
    If (JpegComponent[ScanList[I]].Td > 1) Or (JpegComponent[ScanList[I]].Ta > 1) Then
      DecodeError('table de Huffman JPEG invalide.');
    If (Not JpegHuffman[JpegComponent[ScanList[I]].Td].Defined) Or
       (Not JpegHuffman[2 + JpegComponent[ScanList[I]].Ta].Defined) Then
      DecodeError('table de Huffman JPEG manquante.');
  End;
  SkipBytes(SegmentLength - 2 - 1 - 2 * ScanCount);

  For I := 1 To JpegComponentCount Do
    JpegComponent[I].Pred := 0;
  JpegBitCount := 0;
  JpegMarker := 0;
  Interleaved := ScanCount > 1;

  If Interleaved Then
  Begin
    McuAcross := (ImageWidth + 8 * JpegHMax - 1) Div (8 * JpegHMax);
    McuDown := (ImageHeight + 8 * JpegVMax - 1) Div (8 * JpegVMax);
  End
  Else
  Begin
    Comp := ScanList[1];
    McuAcross := (((Longint(ImageWidth) * JpegComponent[Comp].H + JpegHMax - 1) Div
                   JpegHMax) + 7) Div 8;
    McuDown := (((Longint(ImageHeight) * JpegComponent[Comp].V + JpegVMax - 1) Div
                 JpegVMax) + 7) Div 8;
  End;
  McuTotal := McuAcross * McuDown;

  McuIndex := 0;
  While McuIndex < McuTotal Do
  Begin
    If (JpegRestart > 0) And (McuIndex > 0) And (McuIndex Mod JpegRestart = 0) Then
    Begin
      Marker := JpegNextMarker;
      If (Marker < $D0) Or (Marker > $D7) Then
        DecodeError('marqueur de redemarrage JPEG invalide.');
      JpegBitCount := 0;
      For I := 1 To JpegComponentCount Do
        JpegComponent[I].Pred := 0;
    End;
    McuX := McuIndex Mod McuAcross;
    McuY := McuIndex Div McuAcross;
    For I := 1 To ScanCount Do
    Begin
      Comp := ScanList[I];
      If Interleaved Then
      Begin
        For BlockV := 0 To JpegComponent[Comp].V - 1 Do
          For BlockH := 0 To JpegComponent[Comp].H - 1 Do
          Begin
            JpegDecodeBlock(Comp);
            If Comp = 1 Then
              JpegStoreBlock((McuX * JpegComponent[1].H + BlockH) * 8,
                             (McuY * JpegComponent[1].V + BlockV) * 8);
          End;
      End
      Else
      Begin
        JpegDecodeBlock(Comp);
        If Comp = 1 Then JpegStoreBlock(McuX * 8, McuY * 8);
      End;
    End;
    Inc(McuIndex);
  End;

  For I := 1 To ScanCount Do
    If ScanList[I] = 1 Then JpegLumaDone := True;
End;

Procedure LoadJpeg;
Var
  Marker, Len, U, X: Integer;
Begin
  SkipBytes(2);
  For U := 0 To 7 Do
    For X := 0 To 7 Do
    Begin
      JpegCosine[X, U] := Cos((2 * X + 1) * U * Pi / 16) / 2;
      If U = 0 Then JpegCosine[X, U] := JpegCosine[X, U] / Sqrt(2);
    End;
  For U := 0 To 3 Do
    JpegHuffman[U].Defined := False;
  FillChar(JpegQuant, SizeOf(JpegQuant), 0);
  JpegRestart := 0;
  JpegMarker := 0;
  JpegFrameSeen := False;
  JpegLumaDone := False;

  While Not JpegLumaDone Do
  Begin
    Marker := JpegNextMarker;
    Case Marker Of
      $01, $D0..$D8: ;
      $D9: DecodeError('donnees d image JPEG absentes.');
      $C0, $C1: JpegReadFrame;
      $C2: DecodeError('JPEG progressif non pris en charge (JPEG de base seulement).');
      $C3, $C5..$C7, $C9..$CB, $CD..$CF:
        DecodeError('type de JPEG non pris en charge (JPEG de base seulement).');
      $C4, $DB, $DD: JpegReadTables(Marker);
      $DA: JpegReadScan;
    Else
      Len := ReadBE16;
      SkipBytes(Len - 2);
    End;
  End;
End;

{ ------------------------------------------------------------------ }
{ GIF : decompression LZW de la premiere image                        }
{ ------------------------------------------------------------------ }

Function GifNextByte: Integer;
Begin
  If GifEnded Then
  Begin
    GifNextByte := -1;
    Exit;
  End;
  If GifBlockLeft = 0 Then
  Begin
    GifBlockLeft := NeedByte;
    If GifBlockLeft = 0 Then
    Begin
      GifEnded := True;
      GifNextByte := -1;
      Exit;
    End;
  End;
  Dec(GifBlockLeft);
  GifNextByte := NeedByte;
End;

Function GifRowOf(Number: Integer): Integer;
Var
  Count: Integer;
Begin
  If Not GifInterlaced Then
  Begin
    GifRowOf := Number;
    Exit;
  End;
  Count := (GifFrameHeight + 7) Div 8;
  If Number < Count Then
  Begin
    GifRowOf := Number * 8;
    Exit;
  End;
  Dec(Number, Count);
  Count := (GifFrameHeight + 3) Div 8;
  If Number < Count Then
  Begin
    GifRowOf := 4 + Number * 8;
    Exit;
  End;
  Dec(Number, Count);
  Count := (GifFrameHeight + 1) Div 4;
  If Number < Count Then
  Begin
    GifRowOf := 2 + Number * 4;
    Exit;
  End;
  Dec(Number, Count);
  GifRowOf := 1 + Number * 2;
End;

Procedure GifPutIndex(Index: Integer);
Begin
  If GifRowNumber >= GifFrameHeight Then Exit;
  If Index <> GifTransparent Then
    PutPixel(GifFrameX + GifColumn + 1, GifFrameY + GifRowOf(GifRowNumber) + 1,
             GrayOf(Palette[Index * 3], Palette[Index * 3 + 1],
                    Palette[Index * 3 + 2]), 255);
  Inc(GifColumn);
  If GifColumn >= GifFrameWidth Then
  Begin
    GifColumn := 0;
    Inc(GifRowNumber);
  End;
End;

Procedure GifDecodeImage;
Var
  MinSize, ClearCode, EndCode, NextCode, CodeSize: Integer;
  Code, Old, InCode, First, StackTop, Value: Integer;
  Buffer: Longint;
  BufferBits: Integer;
Begin
  MinSize := NeedByte;
  If (MinSize < 2) Or (MinSize > 8) Then DecodeError('taille de code GIF invalide.');
  GetMem(GifPrefix, SizeOf(TWordBuffer));
  GetMem(GifSuffix, SizeOf(TByteBuffer));
  GetMem(GifStack, SizeOf(TByteBuffer));
  FillChar(GifPrefix^, SizeOf(TWordBuffer), 0);
  FillChar(GifSuffix^, SizeOf(TByteBuffer), 0);
  ClearCode := 1 Shl MinSize;
  EndCode := ClearCode + 1;
  NextCode := ClearCode + 2;
  CodeSize := MinSize + 1;
  Old := -1;
  First := 0;
  Buffer := 0;
  BufferBits := 0;
  GifBlockLeft := 0;
  GifEnded := False;
  GifColumn := 0;
  GifRowNumber := 0;

  While True Do
  Begin
    While BufferBits < CodeSize Do
    Begin
      Value := GifNextByte;
      If Value < 0 Then Exit;
      Buffer := Buffer Or (Longint(Value) Shl BufferBits);
      Inc(BufferBits, 8);
    End;
    Code := Buffer And ((Longint(1) Shl CodeSize) - 1);
    Buffer := Buffer Shr CodeSize;
    Dec(BufferBits, CodeSize);

    If Code = ClearCode Then
    Begin
      CodeSize := MinSize + 1;
      NextCode := ClearCode + 2;
      Old := -1;
    End
    Else If Code = EndCode Then
      Break
    Else If Old < 0 Then
    Begin
      If Code >= ClearCode Then DecodeError('donnees GIF invalides.');
      GifPutIndex(Code);
      First := Code;
      Old := Code;
    End
    Else
    Begin
      If Code > NextCode Then DecodeError('donnees GIF invalides.');
      InCode := Code;
      StackTop := 0;
      If Code = NextCode Then
      Begin
        GifStack^[StackTop] := First;
        Inc(StackTop);
        Code := Old;
      End;
      While Code >= ClearCode Do
      Begin
        GifStack^[StackTop] := GifSuffix^[Code];
        Inc(StackTop);
        Code := GifPrefix^[Code];
      End;
      First := Code;
      GifStack^[StackTop] := First;
      Inc(StackTop);
      If NextCode < 4096 Then
      Begin
        GifPrefix^[NextCode] := Old;
        GifSuffix^[NextCode] := First;
        Inc(NextCode);
        If (NextCode = (1 Shl CodeSize)) And (CodeSize < 12) Then Inc(CodeSize);
      End;
      Old := InCode;
      While StackTop > 0 Do
      Begin
        Dec(StackTop);
        GifPutIndex(GifStack^[StackTop]);
      End;
    End;
  End;
End;

Procedure GifSkipBlocks;
Var
  Size: Byte;
Begin
  Repeat
    Size := NeedByte;
    SkipBytes(Size);
  Until Size = 0;
End;

Procedure GifReadPalette(Colors: Integer);
Var
  I: Integer;
Begin
  For I := 0 To Colors * 3 - 1 Do
    Palette[I] := NeedByte;
End;

Procedure LoadGif;
Var
  Flags, BlockType, ExtType, Size, I, FrameWidth, FrameHeight: Integer;
  Extension: Array[1..255] Of Byte;
Begin
  SkipBytes(6);
  FrameWidth := ReadLE16;
  FrameHeight := ReadLE16;
  SetImageSize(FrameWidth, FrameHeight);
  Flags := NeedByte;
  SkipBytes(2);
  FillChar(Palette, SizeOf(Palette), 0);
  If (Flags And $80) <> 0 Then
    GifReadPalette(1 Shl ((Flags And 7) + 1));
  GifTransparent := -1;

  While True Do
  Begin
    BlockType := NeedByte;
    If BlockType = $21 Then
    Begin
      ExtType := NeedByte;
      If ExtType = $F9 Then
      Begin
        Size := NeedByte;
        For I := 1 To Size Do
          Extension[I] := NeedByte;
        If (Size >= 4) And ((Extension[1] And 1) <> 0) Then
          GifTransparent := Extension[4];
      End;
      GifSkipBlocks;
    End
    Else If BlockType = $2C Then
    Begin
      GifFrameX := ReadLE16;
      GifFrameY := ReadLE16;
      GifFrameWidth := ReadLE16;
      GifFrameHeight := ReadLE16;
      Flags := NeedByte;
      If (GifFrameWidth < 1) Or (GifFrameHeight < 1) Then
        DecodeError('image GIF vide.');
      If (Flags And $80) <> 0 Then
        GifReadPalette(1 Shl ((Flags And 7) + 1));
      GifInterlaced := (Flags And $40) <> 0;
      GifDecodeImage;
      Exit;
    End
    Else If BlockType = $3B Then
      DecodeError('aucune image dans le fichier GIF.')
    Else
      DecodeError('bloc GIF invalide.');
  End;
End;

{ Lecture du PBM ASCII P1 : jetons d'en-tete, puis pixels 0/1 avec ou sans espaces. }
Function PbmNextToken(Var Text1: String): Boolean;
Var
  Value: Integer;
Begin
  Text1 := '';
  Repeat
    Value := ReadBin;
    If Value = Ord('#') Then
      Repeat
        Value := ReadBin;
      Until (Value < 0) Or (Value = 10) Or (Value = 13);
  Until (Value < 0) Or (Value > 32);
  While (Value > 32) And (Value <> Ord('#')) Do
  Begin
    If Length(Text1) < 40 Then Text1 := Text1 + Chr(Value);
    Value := ReadBin;
  End;
  If Value = Ord('#') Then Dec(InPos);
  PbmNextToken := Text1 <> '';
End;

Function PbmNextPixel: Integer;
Var
  Value: Integer;
Begin
  Repeat
    Value := ReadBin;
    If Value = Ord('#') Then
      Repeat
        Value := ReadBin;
      Until (Value < 0) Or (Value = 10) Or (Value = 13);
  Until (Value < 0) Or (Value > 32);
  If Value < 0 Then
    PbmNextPixel := -1
  Else If (Value = Ord('0')) Or (Value = Ord('1')) Then
    PbmNextPixel := Value - Ord('0')
  Else
  Begin
    DecodeError('valeur de pixel PBM invalide.');
    PbmNextPixel := -1;
  End;
End;

Procedure LoadPbm;
Var
  Pixel, ParseError, X, Y: Integer;
  NewWidth, NewHeight: Longint;
Begin
  If (Not PbmNextToken(Token)) Or (Token <> 'P1') Then
    DecodeError('image non prise en charge. Utilisez PBM ASCII P1, PNG, JPEG, GIF ou BMP.');
  If Not PbmNextToken(Token) Then DecodeError('largeur de l''image manquante.');
  Val(Token, NewWidth, ParseError);
  If ParseError <> 0 Then DecodeError('largeur invalide.');
  If Not PbmNextToken(Token) Then DecodeError('hauteur de l''image manquante.');
  Val(Token, NewHeight, ParseError);
  If ParseError <> 0 Then DecodeError('hauteur invalide.');
  SetImageSize(NewWidth, NewHeight);
  For Y := 1 To ImageHeight Do
    For X := 1 To ImageWidth Do
    Begin
      Pixel := PbmNextPixel;
      If Pixel < 0 Then DecodeError('donnees de pixels incompletes.');
      If Pixel = 1 Then
        Image^[Y]^[X] := 0
      Else
        Image^[Y]^[X] := 255;
    End;
  Close(BinFile);
End;

{ ------------------------------------------------------------------ }
{ BMP : 1, 4, 8, 16, 24 et 32 bits, RLE4 / RLE8, masques de bits,    }
{ en-tetes OS/2 et Windows (de haut en bas ou de bas en haut).       }
{ ------------------------------------------------------------------ }

Var
  BmpMaskShift, BmpMaskBits: Array[0..2] Of Integer;

Procedure BmpPrepareMask(Channel: Integer; Mask: Longint);
Begin
  BmpMaskShift[Channel] := 0;
  BmpMaskBits[Channel] := 0;
  If Mask = 0 Then Exit;
  While (Mask And 1) = 0 Do
  Begin
    Mask := Mask Shr 1;
    Inc(BmpMaskShift[Channel]);
  End;
  While (Mask And 1) <> 0 Do
  Begin
    Mask := Mask Shr 1;
    Inc(BmpMaskBits[Channel]);
  End;
End;

Function BmpChannel(Pixel, Mask: Longint; Channel: Integer): Integer;
Begin
  If BmpMaskBits[Channel] = 0 Then
    BmpChannel := 0
  Else
    BmpChannel := ((Pixel And Mask) Shr BmpMaskShift[Channel]) * 255 Div
                  ((Longint(1) Shl BmpMaskBits[Channel]) - 1);
End;

Procedure BmpPutIndex(PixelX, PixelY, Index: Integer);
Begin
  PutPixel(PixelX, PixelY, GrayOf(Palette[Index * 3], Palette[Index * 3 + 1],
           Palette[Index * 3 + 2]), 255);
End;

Procedure LoadBmp;
Var
  DataOffset, HeaderSize, Compression, ColorsUsed, Width, Height: Longint;
  MaskRed, MaskGreen, MaskBlue, Pixel, RowBytes: Longint;
  BitsPerPixel, I, K, Row, Column, PixelY, RowRead, PerByte, Count, Value, Index: Integer;
  Blue, Green, Red, DeltaX, DeltaY, Run: Integer;
  TopDown, Finished: Boolean;
Begin
  SkipBytes(2);
  SkipBytes(4);
  SkipBytes(4);
  DataOffset := ReadLE32;
  HeaderSize := ReadLE32;
  Compression := 0;
  ColorsUsed := 0;
  TopDown := False;
  MaskRed := 0;
  MaskGreen := 0;
  MaskBlue := 0;

  If HeaderSize = 12 Then
  Begin
    Width := ReadLE16;
    Height := ReadLE16;
    SkipBytes(2);
    BitsPerPixel := ReadLE16;
  End
  Else If HeaderSize >= 40 Then
  Begin
    Width := ReadLE32;
    Height := ReadLE32;
    SkipBytes(2);
    BitsPerPixel := ReadLE16;
    Compression := ReadLE32;
    SkipBytes(12);
    ColorsUsed := ReadLE32;
    SkipBytes(4);
    If HeaderSize >= 52 Then
    Begin
      MaskRed := ReadLE32;
      MaskGreen := ReadLE32;
      MaskBlue := ReadLE32;
      SkipBytes(HeaderSize - 52);
    End
    Else If (Compression = 3) Or (Compression = 6) Then
    Begin
      MaskRed := ReadLE32;
      MaskGreen := ReadLE32;
      MaskBlue := ReadLE32;
      If Compression = 6 Then SkipBytes(4);
    End;
  End
  Else
    DecodeError('en-tete BMP non pris en charge.');

  If Height < 0 Then
  Begin
    TopDown := True;
    Height := -Height;
  End;
  If (Width < 1) Or (Height < 1) Then DecodeError('dimensions BMP invalides.');
  If Not (BitsPerPixel In [1, 4, 8, 16, 24, 32]) Then
    DecodeError('profondeur BMP non prise en charge.');
  If (Compression = 4) Or (Compression = 5) Then
    DecodeError('BMP avec JPEG ou PNG integre non pris en charge.');
  If (Compression = 1) And (BitsPerPixel <> 8) Then DecodeError('compression BMP invalide.');
  If (Compression = 2) And (BitsPerPixel <> 4) Then DecodeError('compression BMP invalide.');
  If Compression > 6 Then DecodeError('compression BMP non prise en charge.');
  SetImageSize(Width, Height);

  { Masques des canaux pour 16 et 32 bits. }
  If BitsPerPixel = 16 Then
  Begin
    If (Compression <> 3) And (Compression <> 6) Then
    Begin
      MaskRed := $7C00;
      MaskGreen := $03E0;
      MaskBlue := $001F;
    End;
  End
  Else If BitsPerPixel = 32 Then
    If (Compression <> 3) And (Compression <> 6) Then
    Begin
      MaskRed := $00FF0000;
      MaskGreen := $0000FF00;
      MaskBlue := $000000FF;
    End;
  BmpPrepareMask(0, MaskRed);
  BmpPrepareMask(1, MaskGreen);
  BmpPrepareMask(2, MaskBlue);

  { Palette (entrees B, G, R, + un octet inutilise sauf en format OS/2). }
  FillChar(Palette, SizeOf(Palette), 0);
  If BitsPerPixel <= 8 Then
  Begin
    Count := 1 Shl BitsPerPixel;
    If (ColorsUsed > 0) And (ColorsUsed < Count) Then Count := ColorsUsed;
    For I := 0 To Count - 1 Do
    Begin
      Palette[I * 3 + 2] := NeedByte;
      Palette[I * 3 + 1] := NeedByte;
      Palette[I * 3] := NeedByte;
      If HeaderSize <> 12 Then SkipBytes(1);
    End;
  End;
  If DataOffset > BinPosition Then SkipBytes(DataOffset - BinPosition);

  If (Compression = 1) Or (Compression = 2) Then
  Begin
    Column := 1;
    If TopDown Then PixelY := 1 Else PixelY := Height;
    Finished := False;
    While Not Finished Do
    Begin
      Count := ReadBin;
      Value := ReadBin;
      If (Count < 0) Or (Value < 0) Then Break;
      If Count > 0 Then
      Begin
        For K := 0 To Count - 1 Do
        Begin
          If BitsPerPixel = 8 Then
            Index := Value
          Else If (K And 1) = 0 Then
            Index := Value Shr 4
          Else
            Index := Value And 15;
          BmpPutIndex(Column, PixelY, Index);
          Inc(Column);
        End;
      End
      Else If Value = 0 Then
      Begin
        Column := 1;
        If TopDown Then Inc(PixelY) Else Dec(PixelY);
      End
      Else If Value = 1 Then
        Finished := True
      Else If Value = 2 Then
      Begin
        DeltaX := NeedByte;
        DeltaY := NeedByte;
        Inc(Column, DeltaX);
        If TopDown Then Inc(PixelY, DeltaY) Else Dec(PixelY, DeltaY);
      End
      Else
      Begin
        Run := Value;
        If BitsPerPixel = 8 Then
        Begin
          For K := 1 To Run Do
          Begin
            BmpPutIndex(Column, PixelY, NeedByte);
            Inc(Column);
          End;
          If (Run And 1) <> 0 Then SkipBytes(1);
        End
        Else
        Begin
          For K := 0 To Run - 1 Do
          Begin
            If (K And 1) = 0 Then Value := NeedByte;
            If (K And 1) = 0 Then
              Index := Value Shr 4
            Else
              Index := Value And 15;
            BmpPutIndex(Column, PixelY, Index);
            Inc(Column);
          End;
          If (((Run + 1) Div 2) And 1) <> 0 Then SkipBytes(1);
        End;
      End;
      If (PixelY < 1) Or (PixelY > Height) Then Finished := True;
    End;
    Exit;
  End;

  RowBytes := ((Width * BitsPerPixel + 31) Div 32) * 4;
  For Row := 0 To Height - 1 Do
  Begin
    If TopDown Then PixelY := Row + 1 Else PixelY := Height - Row;
    RowRead := 0;
    Column := 1;
    If BitsPerPixel <= 8 Then
    Begin
      PerByte := 8 Div BitsPerPixel;
      While Column <= Width Do
      Begin
        Value := NeedByte;
        Inc(RowRead);
        For K := 0 To PerByte - 1 Do
          If Column <= Width Then
          Begin
            Index := (Value Shr (8 - BitsPerPixel * (K + 1))) And ((1 Shl BitsPerPixel) - 1);
            BmpPutIndex(Column, PixelY, Index);
            Inc(Column);
          End;
      End;
    End
    Else
      While Column <= Width Do
      Begin
        If BitsPerPixel = 24 Then
        Begin
          Blue := NeedByte;
          Green := NeedByte;
          Red := NeedByte;
          Inc(RowRead, 3);
        End
        Else
        Begin
          Pixel := NeedByte;
          Pixel := Pixel Or (Longint(NeedByte) Shl 8);
          Inc(RowRead, 2);
          If BitsPerPixel = 32 Then
          Begin
            Pixel := Pixel Or (Longint(NeedByte) Shl 16);
            Pixel := Pixel Or (Longint(NeedByte) Shl 24);
            Inc(RowRead, 2);
          End;
          Red := BmpChannel(Pixel, MaskRed, 0);
          Green := BmpChannel(Pixel, MaskGreen, 1);
          Blue := BmpChannel(Pixel, MaskBlue, 2);
        End;
        PutPixel(Column, PixelY, GrayOf(Red, Green, Blue), 255);
        Inc(Column);
      End;
    SkipBytes(RowBytes - RowRead);
  End;
End;

{ ------------------------------------------------------------------ }
{ Normalisation : l'image devient une carte de couverture d'encre    }
{ (0 = fond, 15 = encre pleine), quelle que soit la polarite.        }
{ ------------------------------------------------------------------ }

Procedure NormalizeImage;
Var
  X, Y: Integer;
  Histogram: Array[0..255] Of Longint;
  Lookup: Array[0..255] Of Byte;
  Row: PImageRow;
  Pixel, Background, Foreground, Span, Level: Integer;
  DarkCount, LightCount, Total, Accumulated: Longint;
  DarkText: Boolean;
Begin
  FillChar(Histogram, SizeOf(Histogram), 0);
  For Y := 1 To ImageHeight Do
  Begin
    Row := Image^[Y];
    For X := 1 To ImageWidth Do
      Inc(Histogram[Row^[X]]);
  End;

  Background := 0;
  For Pixel := 1 To 255 Do
    If Histogram[Pixel] > Histogram[Background] Then Background := Pixel;

  DarkCount := 0;
  LightCount := 0;
  For Pixel := 0 To 255 Do
    If Pixel < Background - 20 Then
      Inc(DarkCount, Histogram[Pixel])
    Else If Pixel > Background + 20 Then
      Inc(LightCount, Histogram[Pixel]);
  DarkText := DarkCount >= LightCount;

  { Teinte du texte : 2e centile des pixels du cote du texte. }
  If DarkText Then
  Begin
    Total := DarkCount;
    Foreground := Background - 20;
    Accumulated := 0;
    For Pixel := 0 To Background - 21 Do
    Begin
      Inc(Accumulated, Histogram[Pixel]);
      If Accumulated * 100 >= Total * 2 Then
      Begin
        Foreground := Pixel;
        Break;
      End;
    End;
  End
  Else
  Begin
    Total := LightCount;
    Foreground := Background + 20;
    Accumulated := 0;
    For Pixel := 255 Downto Background + 21 Do
    Begin
      Inc(Accumulated, Histogram[Pixel]);
      If Accumulated * 100 >= Total * 2 Then
      Begin
        Foreground := Pixel;
        Break;
      End;
    End;
  End;
  Span := Abs(Background - Foreground);
  If Span < 1 Then Span := 1;

  For Pixel := 0 To 255 Do
  Begin
    If DarkText Then
      Level := Background - Pixel
    Else
      Level := Pixel - Background;
    If Level <= 0 Then
      Lookup[Pixel] := 0
    Else
    Begin
      Level := (Level * 15 + Span Div 2) Div Span;
      If Level > 15 Then Level := 15;
      Lookup[Pixel] := Level;
    End;
  End;

  For Y := 1 To ImageHeight Do
  Begin
    Row := Image^[Y];
    For X := 1 To ImageWidth Do
      Row^[X] := Lookup[Row^[X]];
  End;
End;

{ ------------------------------------------------------------------ }
{ Reconnaissance par gabarits (Segoe UI, Arial, Consolas) et          }
{ programmation dynamique sur chaque ligne de texte.                  }
{ ------------------------------------------------------------------ }

Const
  InkLevel = 2;
  SkipFactor = 5;
  GlyphPenalty = 225;
  AccentPenalty = 90;
  OverlapPenalty = 40;
  RarePenalty = 110;
  KanaPenalty = 60;
  MaxOverlap = 2;
  Infinity = 1000000000;
  MaxRecognizeWidth = 16000;
  MasterEm = 48;
  FontSegoe = 0;
  FontArial = 1;
  FontConsolas = 2;
  FontYuGothic = 3;
  FontAuto = -1;
  LangEnglish = 1;
  LangFrench = 2;
  LangGerman = 4;
  LangSpanish = 8;
  LangPortuguese = 16;
  LangSwedish = 32;
  LangItalian = 64;
  LangAlbanian = 128;
  LangDanish = 256;
  LangJapanese = 512;

Type
  TLongArray = Array[0..16370] Of Longint;
  PLongArray = ^TLongArray;
  TWordArray = Array[0..32759] Of Word;
  PWordArray = ^TWordArray;
  TIntegerArray = Array[0..8191] Of Integer;
  PIntegerArray = ^TIntegerArray;
  TShortArray = Array[0..255] Of ShortInt;
  PShortArray = ^TShortArray;
  TSat = Array[0..MasterEm, 0..MasterEm] Of Word;
  TTemplate = Record
    Width, Height, Top: Integer;
    Pen, Advance, Extra: Integer;
    Squares: Longint;
    Root: Real;
    PixelSize: Word;
    Stem: Boolean;
    Pixels: PRowBuffer;
  End;

Var
  Templates: Array[0..TemplateCount - 1] Of TTemplate;
  TemplateLimit, MaxOverlapUsed: Integer;
  FontWidth, FontHeight: PRowBuffer;
  FontLeft, FontTop: PShortArray;
  FontAdvance, FontBits: PWordArray;
  FontSpace, CurrentFont, FontOption, SizeOption, CurrentEm, LanguageMask: Integer;
  FontOffset: Array[0..GlyphCount] Of Word;
  KanaOffset: Array[0..KanaCount] Of Word;
  ExactOffset: Array[0..GlyphCount * 4] Of Word;
  Sat: TSat;
  Scratch: Array[0..4095] Of Byte;
  BestCost, PrefixSquares, ColumnSquares, LineInk: PLongArray;
  ColumnMax: PRowBuffer;
  BackX, BackT, BackS, OutX, OutT, LineBuffer: PWordArray;
  LineTop, LineBottom, LineEstimate, LineFirst: PIntegerArray;
  LineCount, LineLength, SampleCount, SearchFont, SearchEm: Integer;
  SampleLine: Array[0..3] Of Integer;
  SearchScore, ScoreBonus: Real;
  EvalCount, EvalTotal: Integer;
  FullScoring, CoarseScoring, CoarsePass, UseExact: Boolean;

Function FloorInt(Value: Real): Integer;
Var
  Whole: Integer;
Begin
  Whole := Trunc(Value);
  If Value < Whole Then Dec(Whole);
  FloorInt := Whole;
End;

Function CeilInt(Value: Real): Integer;
Var
  Whole: Integer;
Begin
  Whole := Trunc(Value);
  If Value > Whole Then Inc(Whole);
  CeilInt := Whole;
End;

Const
  FontNames: Array[0..3] Of String[9] = ('Segoe UI', 'Arial', 'Consolas', 'Yu Gothic');

Procedure SelectFont(FontNo: Integer);
Var
  I: Integer;
Begin
  CurrentFont := FontNo;
  Case FontNo Of
    FontSegoe:
    Begin
      FontWidth := PRowBuffer(@SegoeWidth);
      FontHeight := PRowBuffer(@SegoeHeight);
      FontLeft := PShortArray(@SegoeLeft);
      FontTop := PShortArray(@SegoeTop);
      FontAdvance := PWordArray(@SegoeAdvance);
      FontBits := PWordArray(@SegoeBits);
      FontSpace := SegoeSpace;
    End;
    FontArial:
    Begin
      FontWidth := PRowBuffer(@ArialWidth);
      FontHeight := PRowBuffer(@ArialHeight);
      FontLeft := PShortArray(@ArialLeft);
      FontTop := PShortArray(@ArialTop);
      FontAdvance := PWordArray(@ArialAdvance);
      FontBits := PWordArray(@ArialBits);
      FontSpace := ArialSpace;
    End;
    FontConsolas:
    Begin
      FontWidth := PRowBuffer(@ConsolasWidth);
      FontHeight := PRowBuffer(@ConsolasHeight);
      FontLeft := PShortArray(@ConsolasLeft);
      FontTop := PShortArray(@ConsolasTop);
      FontAdvance := PWordArray(@ConsolasAdvance);
      FontBits := PWordArray(@ConsolasBits);
      FontSpace := ConsolasSpace;
    End;
  Else
    FontWidth := PRowBuffer(@YuGothicWidth);
    FontHeight := PRowBuffer(@YuGothicHeight);
    FontLeft := PShortArray(@YuGothicLeft);
    FontTop := PShortArray(@YuGothicTop);
    FontAdvance := PWordArray(@YuGothicAdvance);
    FontBits := PWordArray(@YuGothicBits);
    FontSpace := YuGothicSpace;
  End;
  FontOffset[0] := 0;
  For I := 0 To GlyphCount - 1 Do
    FontOffset[I + 1] := FontOffset[I] +
      (FontWidth^[I] * FontHeight^[I] + 7) Div 8;
  ExactOffset[0] := 0;
  For I := 0 To GlyphCount * 4 - 1 Do
    ExactOffset[I + 1] := ExactOffset[I] + ExactWidth[I] * ExactHeight[I];
  KanaOffset[0] := 0;
  For I := 0 To KanaCount - 1 Do
    KanaOffset[I + 1] := KanaOffset[I] + (KanaWidth[I] * KanaHeight[I] + 7) Div 8;
End;

{ Acces uniforme aux caracteres latins (par police) puis aux kana (communs). }
Function GlyphCodeOf(G: Integer): Integer;
Begin
  If G < GlyphCount Then GlyphCodeOf := GlyphCode[G] Else GlyphCodeOf := KanaCode[G - GlyphCount];
End;

Function GlyphWidthOf(G: Integer): Integer;
Begin
  If G < GlyphCount Then GlyphWidthOf := FontWidth^[G] Else GlyphWidthOf := KanaWidth[G - GlyphCount];
End;

Function GlyphHeightOf(G: Integer): Integer;
Begin
  If G < GlyphCount Then GlyphHeightOf := FontHeight^[G] Else GlyphHeightOf := KanaHeight[G - GlyphCount];
End;

Function GlyphLeftOf(G: Integer): Integer;
Begin
  If G < GlyphCount Then GlyphLeftOf := FontLeft^[G] Else GlyphLeftOf := KanaLeft[G - GlyphCount];
End;

Function GlyphTopOf(G: Integer): Integer;
Begin
  If G < GlyphCount Then GlyphTopOf := FontTop^[G] Else GlyphTopOf := KanaTop[G - GlyphCount];
End;

Function GlyphAdvanceOf(G: Integer): Integer;
Begin
  If G < GlyphCount Then GlyphAdvanceOf := FontAdvance^[G] Else GlyphAdvanceOf := 1024;
End;

Function MasterBit(Glyph, Index: Integer): Integer;
Var
  BytePosition: Longint;
  Value: Word;
Begin
  If Glyph >= GlyphCount Then
  Begin
    BytePosition := KanaOffset[Glyph - GlyphCount] + (Index Shr 3);
    Value := KanaBits[BytePosition Shr 1];
  End
  Else
  Begin
    BytePosition := FontOffset[Glyph] + (Index Shr 3);
    Value := FontBits^[BytePosition Shr 1];
  End;
  If (BytePosition And 1) <> 0 Then Value := Value Shr 8;
  MasterBit := (Value Shr (7 - (Index And 7))) And 1;
End;

Procedure FreeTemplates;
Var
  I: Integer;
Begin
  For I := 0 To TemplateCount - 1 Do
  Begin
    If Templates[I].Pixels <> Nil Then
      FreeMem(Templates[I].Pixels, Templates[I].PixelSize);
    Templates[I].Pixels := Nil;
    Templates[I].Width := 0;
    Templates[I].Height := 0;
  End;
End;

{ Une lettre accentuee n'existe que dans les langues qui l'utilisent. }
Function LanguageAllows(Glyph: Integer): Boolean;
Begin
  If Glyph >= GlyphCount Then
    LanguageAllows := (LanguageMask And LangJapanese) <> 0
  Else
    LanguageAllows := (GlyphLanguage[Glyph] And LanguageMask) <> 0;
End;

Procedure AssignExtra(Index, G, FontNo: Integer);
Begin
  { Un trait vertical (i, l, I, !, |, 1) ne se chevauche jamais : ce serait un doublon. }
  Templates[Index].Stem := GlyphCodeOf(G) In [33, 49, 73, 105, 108, 124];
  Templates[Index].Root := Sqrt(Templates[Index].Squares);
  { Caracteres rares dans le texte courant : on les prefere moins. }
  Case GlyphCodeOf(G) Of
    33, 93, 124: Templates[Index].Extra := RarePenalty;
    91: Templates[Index].Extra := RarePenalty Div 2;
    49:
      If FontNo = FontSegoe Then
        Templates[Index].Extra := RarePenalty
      Else
        Templates[Index].Extra := 0;
    128..2047: Templates[Index].Extra := AccentPenalty;
    12288..12543: Templates[Index].Extra := KanaPenalty;
  Else
    Templates[Index].Extra := 0;
  End;
End;

{ Gabarits exacts de Segoe UI 13,33 px (caracteres latins). }
Procedure LoadExactTemplates(G: Integer);
Var
  Phase, Index, J, Value: Integer;
  Position, Start: Longint;
Begin
  For Phase := 0 To 3 Do
  Begin
    Index := G * 4 + Phase;
    If CoarseScoring And ((Phase And 1) <> 0) Then Continue;
    Start := ExactOffset[Index];
    Templates[Index].Width := ExactWidth[Index];
    Templates[Index].Height := ExactHeight[Index];
    Templates[Index].Top := ExactTop[Index];
    Templates[Index].Pen := ExactPen[Index];
    Templates[Index].Advance := (Longint(GlyphAdvanceOf(G)) * ExactEm * 4 + 51200) Div 102400;
    Templates[Index].PixelSize := Templates[Index].Width * Templates[Index].Height;
    GetMem(Templates[Index].Pixels, Templates[Index].PixelSize);
    Templates[Index].Squares := 0;
    For J := 0 To Templates[Index].PixelSize - 1 Do
    Begin
      Position := Start + J;
      Value := (ExactData[Position Shr 2] Shr ((Position And 3) * 4)) And 15;
      Templates[Index].Pixels^[J] := Value;
      Inc(Templates[Index].Squares, Value * Value);
    End;
    AssignExtra(Index, G, FontSegoe);
  End;
End;

Function ClampTo(Value, Low, High: Integer): Integer;
Begin
  If Value < Low Then Value := Low;
  If Value > High Then Value := High;
  ClampTo := Value;
End;

{ Derive les gabarits (4 positions de sous-pixel) de la police maitre,
  a la taille Em100 / 100 pixels d'em : couverture de chaque pixel cible
  par l'image maitre, sur 16 niveaux. }
Procedure BuildTemplates(FontNo, Em100, Glyphs: Integer);
Var
  G, Phase, I, J, I0, I1, J0, J1, Rows, Cols, MW, MH, XL, YT: Integer;
  A0, A1, B0, B1, CA0, CA1, CB0, CB1, Total, Value, Index: Integer;
  MinR, MaxR, MinC, MaxC, R, C, Position: Integer;
  Scale, Shift: Real;
Begin
  FreeTemplates;
  SelectFont(FontNo);
  Scale := Em100 / 100 / MasterEm;
  FillChar(Sat, SizeOf(Sat), 0);
  For G := 0 To Glyphs - 1 Do
  Begin
    { Les lettres accentuees n'existent que dans les langues demandees. }
    If (G >= UnaccentedCount) And (Not LanguageAllows(G)) Then Continue;
    If CoarseScoring And ((LanguageMask And LangJapanese) = 0) Then
      If Not (((GlyphCodeOf(G) >= Ord('a')) And (GlyphCodeOf(G) <= Ord('z'))) Or
              ((GlyphCodeOf(G) >= Ord('0')) And (GlyphCodeOf(G) <= Ord('9')))) Then Continue;
    If UseExact And (FontNo = FontSegoe) And (Em100 = ExactEm) And (G < GlyphCount) Then
    Begin
      LoadExactTemplates(G);
      Continue;
    End;
    MW := GlyphWidthOf(G);
    MH := GlyphHeightOf(G);
    XL := GlyphLeftOf(G);
    YT := GlyphTopOf(G);
    For R := 0 To MH - 1 Do
      For C := 0 To MW - 1 Do
        Sat[R + 1, C + 1] := Sat[R, C + 1] + Sat[R + 1, C] - Sat[R, C] +
                             MasterBit(G, R * MW + C);

    For Phase := 0 To 3 Do
    Begin
      Index := G * 4 + Phase;
      { Les kana sont larges : deux positions de sous-pixel suffisent. }
      If ((G >= GlyphCount) Or CoarseScoring) And ((Phase And 1) <> 0) Then Continue;
      Shift := Phase / 4;
      I0 := FloorInt(Shift + XL * Scale) - 1;
      I1 := CeilInt(Shift + (XL + MW) * Scale) + 1;
      J0 := FloorInt(-YT * Scale) - 1;
      J1 := CeilInt((MH - YT) * Scale) + 1;
      Rows := J1 - J0;
      Cols := I1 - I0;
      If Rows * Cols > SizeOf(Scratch) Then
      Begin
        Writeln('Erreur : taille de police trop grande.');
        Halt(2);
      End;
      For J := 0 To Rows - 1 Do
      Begin
        A0 := Round((J0 + J) / Scale + YT);
        A1 := Round((J0 + J + 1) / Scale + YT);
        If A1 <= A0 Then A1 := A0 + 1;
        CA0 := ClampTo(A0, 0, MH);
        CA1 := ClampTo(A1, 0, MH);
        For I := 0 To Cols - 1 Do
        Begin
          B0 := Round((I0 + I - Shift) / Scale - XL);
          B1 := Round((I0 + I + 1 - Shift) / Scale - XL);
          If B1 <= B0 Then B1 := B0 + 1;
          CB0 := ClampTo(B0, 0, MW);
          CB1 := ClampTo(B1, 0, MW);
          Value := 0;
          If (CA1 > CA0) And (CB1 > CB0) Then
          Begin
            Total := Sat[CA1, CB1] - Sat[CA0, CB1] - Sat[CA1, CB0] + Sat[CA0, CB0];
            Value := Round(15 * Total / ((A1 - A0) * (B1 - B0)));
            If Value > 15 Then Value := 15;
          End;
          Scratch[J * Cols + I] := Value;
        End;
      End;

      MinR := Rows;
      MaxR := -1;
      MinC := Cols;
      MaxC := -1;
      For J := 0 To Rows - 1 Do
        For I := 0 To Cols - 1 Do
          If Scratch[J * Cols + I] >= 1 Then
          Begin
            If J < MinR Then MinR := J;
            If J > MaxR Then MaxR := J;
            If I < MinC Then MinC := I;
            If I > MaxC Then MaxC := I;
          End;

      If MaxR < 0 Then Continue;
      Templates[Index].Width := MaxC - MinC + 1;
      Templates[Index].Height := MaxR - MinR + 1;
      Templates[Index].Top := -(J0 + MinR);
      Templates[Index].Pen := Round(4 * (Shift - (I0 + MinC)));
      Templates[Index].Advance := (Longint(GlyphAdvanceOf(G)) * Em100 * 4 + 51200) Div 102400;
      Templates[Index].PixelSize := Templates[Index].Width * Templates[Index].Height;
      GetMem(Templates[Index].Pixels, Templates[Index].PixelSize);
      Templates[Index].Squares := 0;
      Position := 0;
      For J := MinR To MaxR Do
        For I := MinC To MaxC Do
        Begin
          Value := Scratch[J * Cols + I];
          Templates[Index].Pixels^[Position] := Value;
          Inc(Templates[Index].Squares, Value * Value);
          Inc(Position);
        End;

      AssignExtra(Index, G, FontNo);
    End;
  End;
  TemplateLimit := Glyphs * 4;
End;

Function RowSum(Number: Integer): Longint;
Var
  Row: PImageRow;
  Column: Integer;
  Sum: Longint;
Begin
  Row := Image^[Number];
  Sum := 0;
  For Column := 1 To ImageWidth Do
    Inc(Sum, Row^[Column]);
  RowSum := Sum;
End;

{ Prepare les sommes par colonne de la bande de lignes Top..Bottom. }
Procedure PrepareLine(Top, Bottom: Integer);
Var
  Row: PImageRow;
  Column, Number, Value: Integer;
Begin
  FillChar(ColumnMax^, ImageWidth, 0);
  FillChar(ColumnSquares^, Word(ImageWidth * SizeOf(Longint)), 0);
  For Number := Top To Bottom Do
  Begin
    Row := Image^[Number];
    For Column := 1 To ImageWidth Do
    Begin
      Value := Row^[Column];
      If Value > ColumnMax^[Column - 1] Then ColumnMax^[Column - 1] := Value;
      Inc(ColumnSquares^[Column - 1], Value * Value);
    End;
  End;
  PrefixSquares^[0] := 0;
  For Column := 0 To ImageWidth - 1 Do
    PrefixSquares^[Column + 1] := PrefixSquares^[Column] + ColumnSquares^[Column];
End;

{ Meilleur decoupage de la ligne pour une ligne de base donnee. Un gabarit
  peut mordre de 1 ou 2 colonnes sur le precedent (crenage, ex. Tr). }
Function MatchLine(Base: Integer): Longint;
Var
  Column, Start, Overlap, Index, Width, Height, TopRow, Rows, Cols, Position, Finish: Integer;
  Cost, Sum, Penalty, Energy: Longint;
  Gap: Real;
  Row: PImageRow;
  Pixels: PRowBuffer;
Begin
  { Borne superieure de depart : ne rien reconnaitre du tout (colonnes sautees).
    Elle permet d'ecarter tres tot les gabarits qui ne peuvent pas faire mieux. }
  BestCost^[0] := 0;
  BackX^[0] := 0;
  BackT^[0] := 0;
  BackS^[0] := 0;
  For Column := 1 To ImageWidth + 7 Do
  Begin
    If Column <= ImageWidth Then
      BestCost^[Column] := PrefixSquares^[Column] * SkipFactor
    Else
      BestCost^[Column] := Infinity;
    BackX^[Column] := Column - 1;
    BackT^[Column] := 0;
    BackS^[Column] := 0;
  End;

  For Column := 0 To ImageWidth - 1 Do
  Begin
    Cost := BestCost^[Column] + ColumnSquares^[Column] * SkipFactor;
    If Cost < BestCost^[Column + 1] Then
    Begin
      BestCost^[Column + 1] := Cost;
      BackX^[Column + 1] := Column;
      BackT^[Column + 1] := 0;
    End;

    For Overlap := 0 To MaxOverlapUsed Do
    Begin
      Start := Column - Overlap;
      If Start < 0 Then Break;
      If (ColumnMax^[Start] >= InkLevel) Or
         ((Start + 1 < ImageWidth) And (ColumnMax^[Start + 1] >= InkLevel)) Then
        For Index := 0 To TemplateLimit - 1 Do
        Begin
          { Pas de crenage pour les kana. }
          If (Overlap > 0) And (Index >= GlyphCount * 4) Then Break;
          Width := Templates[Index].Width;
          If (Width <= Overlap) Or (Start + Width > ImageWidth) Then Continue;
          If (Overlap > 0) And Templates[Index].Stem Then Continue;
          Height := Templates[Index].Height;
          TopRow := Base - Templates[Index].Top + 1;
          If (TopRow < 1) Or (TopRow + Height - 1 > ImageHeight) Then Continue;
          Finish := Start + Width;
          Penalty := GlyphPenalty + Overlap * OverlapPenalty + Templates[Index].Extra;

          { Elagage 1 : le cout ne peut pas etre inferieur a la penalite. }
          If BestCost^[Column] + Penalty >= BestCost^[Finish] Then Continue;

          { Elagage 2 (Cauchy-Schwarz) : la somme des produits est au plus
            racine(energie du gabarit x energie de l'image), d'ou un cout
            minimal (racine(E gabarit) - racine(E image))^2. }
          Energy := PrefixSquares^[Finish] - PrefixSquares^[Start];
          Gap := Templates[Index].Root - Sqrt(Energy + Energy Div 8 + 64);
          If Gap > 0 Then
            If BestCost^[Column] + Penalty + Gap * Gap >= BestCost^[Finish] Then Continue;

          Sum := 0;
          Position := 0;
          Pixels := Templates[Index].Pixels;
          For Rows := 0 To Height - 1 Do
          Begin
            Row := Image^[TopRow + Rows];
            For Cols := 1 To Width Do
            Begin
              Sum := Sum + Row^[Start + Cols] * Pixels^[Position];
              Inc(Position);
            End;
          End;
          Cost := BestCost^[Column] + Templates[Index].Squares - 2 * Sum + Energy + Penalty;
          If Cost < BestCost^[Finish] Then
          Begin
            BestCost^[Finish] := Cost;
            BackX^[Finish] := Column;
            BackS^[Finish] := Start;
            BackT^[Finish] := Index + 1;
          End;
        End;
    End;
  End;
  MatchLine := BestCost^[ImageWidth];
End;

Procedure WriteGlyph(Code: Integer);
Begin
  If Code < 128 Then
    Write(OutputFile, Chr(Code))
  Else If Code < 2048 Then
    Write(OutputFile, Chr($C0 Or (Code Shr 6)), Chr($80 Or (Code And $3F)))
  Else
    Write(OutputFile, Chr($E0 Or (Code Shr 12)), Chr($80 Or ((Code Shr 6) And $3F)),
          Chr($80 Or (Code And $3F)));
End;

Function RowHasText(Number: Integer): Boolean;
Var
  Row: PImageRow;
  Column: Integer;
Begin
  Row := Image^[Number];
  RowHasText := False;
  For Column := 1 To ImageWidth Do
    If Row^[Column] >= InkLevel Then
    Begin
      RowHasText := True;
      Exit;
    End;
End;

Procedure AppendCode(Code: Integer);
Begin
  LineBuffer^[LineLength] := Code;
  Inc(LineLength);
End;

Procedure AppendSpaces(Count: Integer);
Begin
  While Count > 0 Do
  Begin
    AppendCode(32);
    Dec(Count);
  End;
End;

Function IsUpper(Code: Integer): Boolean;
Begin
  IsUpper := ((Code >= Ord('A')) And (Code <= Ord('Z'))) Or
             ((Code >= 192) And (Code <= 222) And (Code <> 215));
End;

Function IsLower(Code: Integer): Boolean;
Begin
  IsLower := ((Code >= Ord('a')) And (Code <= Ord('z'))) Or
             ((Code >= 223) And (Code <= 255) And (Code <> 247));
End;

(* Les trois fermants se confondent facilement entre eux : chacun doit
   refermer l'ouvrant le plus recent de la ligne. *)
Procedure FixBrackets;
Var
  K, Depth, Code: Integer;
  Stack: Array[0..255] Of Integer;
Begin
  Depth := 0;
  For K := 0 To LineLength - 1 Do
  Begin
    Code := LineBuffer^[K];
    If (Code = Ord('(')) Or (Code = Ord('[')) Or (Code = Ord('{')) Then
    Begin
      If Depth < 256 Then
      Begin
        Stack[Depth] := Code;
        Inc(Depth);
      End;
    End
    Else If (Code = Ord(')')) Or (Code = Ord(']')) Or (Code = Ord('}')) Then
      If Depth > 0 Then
      Begin
        Dec(Depth);
        If Stack[Depth] = Ord('(') Then
          LineBuffer^[K] := Ord(')')
        Else If Stack[Depth] = Ord('[') Then
          LineBuffer^[K] := Ord(']')
        Else
          LineBuffer^[K] := Ord('}');
      End;
  End;
End;

{ Corrections de contexte avant l'ecriture de la ligne. }
{ Une ligne sans symbole de programmation est du texte courant. }
Function LooksLikeProse: Boolean;
Var
  K: Integer;
Begin
  LooksLikeProse := True;
  For K := 0 To LineLength - 1 Do
    If LineBuffer^[K] < 128 Then
      If Chr(LineBuffer^[K]) In ['{', '}', ';', '=', '_', '<', '>', '$', '&', '|', #92] Then
        LooksLikeProse := False;
End;

Procedure FlushLine;
Var
  K, Before: Integer;
Begin
  FixBrackets;
  For K := 0 To LineLength - 2 Do
    { Un I colle a un = en debut de mot est un !. }
    If (LineBuffer^[K] = Ord('I')) And (LineBuffer^[K + 1] = Ord('=')) And
       ((K = 0) Or (LineBuffer^[K - 1] = 32) Or (LineBuffer^[K - 1] = Ord('('))) Then
      LineBuffer^[K] := Ord('!');
  { En Arial (et pour du texte courant en Segoe UI), I et l se ressemblent : on tranche selon le contexte. Apres
    une minuscule, c'est un l ; en debut de mot suivi d'une minuscule, c'est
    un I seulement en debut de phrase ; sinon c'est un I. }
  If (CurrentFont = FontArial) Or (((CurrentFont = FontSegoe) Or (CurrentFont = FontYuGothic)) And LooksLikeProse) Then
    For K := 0 To LineLength - 1 Do
      If (LineBuffer^[K] = Ord('I')) Or (LineBuffer^[K] = Ord('l')) Then
      Begin
        If (K > 0) And IsLower(LineBuffer^[K - 1]) Then
          LineBuffer^[K] := Ord('l')
        Else If (K > 0) And IsUpper(LineBuffer^[K - 1]) Then
        Begin
          { Apres une majuscule : I seulement devant une autre majuscule (HIV). }
          If (K + 1 < LineLength) And IsUpper(LineBuffer^[K + 1]) Then
            LineBuffer^[K] := Ord('I')
          Else
            LineBuffer^[K] := Ord('l');
        End
        Else If (K + 1 < LineLength) And (LineBuffer^[K + 1] = Ord('''')) And
                ((LanguageMask And (Not LangEnglish)) <> 0) Then
          LineBuffer^[K] := Ord('l')
        Else If (K + 1 < LineLength) And IsLower(LineBuffer^[K + 1]) Then
        Begin
          Before := K - 1;
          While (Before >= 0) And (LineBuffer^[Before] = 32) Do
            Dec(Before);
          If (Before < 0) Or (LineBuffer^[Before] = Ord('.')) Or
             (LineBuffer^[Before] = Ord('!')) Or (LineBuffer^[Before] = Ord('?')) Or
             (LineBuffer^[Before] = Ord(':')) Or (LineBuffer^[Before] = Ord('"')) Or
             (LineBuffer^[Before] = Ord('(')) Then
            LineBuffer^[K] := Ord('I')
          Else
            LineBuffer^[K] := Ord('l');
        End
        Else
          LineBuffer^[K] := Ord('I');
      End;
  For K := 0 To LineLength - 1 Do
    WriteGlyph(LineBuffer^[K]);
  Writeln(OutputFile);
  LineLength := 0;
End;

Function IsSampleLine(Number: Integer): Boolean;
Var
  K: Integer;
Begin
  IsSampleLine := False;
  For K := 0 To SampleCount - 1 Do
    If SampleLine[K] = Number Then IsSampleLine := True;
End;

{ Cout relatif de la reconnaissance des lignes echantillons avec une
  police et une taille donnees (plus petit = meilleur). }
Procedure TryCandidate(FontNo, Em100: Integer);
Var
  K, Base, UsedSamples: Integer;
  BestCostLine, LineCost: Longint;
  Cost, Energy, Score: Real;
Begin
  Inc(EvalCount);
  Progress('Detection de la police et de la taille : essai ' + NumberText(EvalCount) +
           '/~' + NumberText(EvalTotal) + ' (' + FontNames[FontNo] + ' ' + EmText(Em100) + ')');
  UsedSamples := SampleCount;
  CoarseScoring := CoarsePass And (Not FullScoring);
  If FullScoring Then
  Begin
    { Evaluation fidele : tous les caracteres de la langue, avec crenage. }
    BuildTemplates(FontNo, Em100, TotalGlyphs);
    MaxOverlapUsed := MaxOverlap;
  End
  Else
  Begin
    If (LanguageMask And LangJapanese) <> 0 Then
      BuildTemplates(FontNo, Em100, TotalGlyphs)
    Else
      BuildTemplates(FontNo, Em100, UnaccentedCount);
    MaxOverlapUsed := 0;
  End;
  If ((LanguageMask And LangJapanese) <> 0) And (UsedSamples > 2) Then UsedSamples := 2;
  { Recherche grossiere : peu de lignes et peu de gabarits suffisent. }
  If (Not FullScoring) And (Not CoarseScoring) And (UsedSamples > 3) Then UsedSamples := 3;
  If CoarseScoring Then
    If (LanguageMask And LangJapanese) <> 0 Then
      UsedSamples := 1
    Else If UsedSamples > 2 Then
      UsedSamples := 2;
  Cost := 0;
  Energy := 0;
  For K := 0 To UsedSamples - 1 Do
  Begin
    PrepareLine(LineTop^[SampleLine[K]], LineBottom^[SampleLine[K]]);
    If (LanguageMask And LangJapanese) <> 0 Then
    Begin
      { Les kana n'ont pas de ligne de base nette : on essaie quelques lignes. }
      BestCostLine := Infinity * 2;
      For Base := LineBottom^[SampleLine[K]] - Em100 Div 500 - 1 To LineBottom^[SampleLine[K]] - 1 Do
      Begin
        LineCost := MatchLine(Base);
        If LineCost < BestCostLine Then BestCostLine := LineCost;
      End;
      Cost := Cost + BestCostLine;
    End
    Else
      Cost := Cost + MatchLine(LineEstimate^[SampleLine[K]]);
    Energy := Energy + PrefixSquares^[ImageWidth];
  End;
  If Energy < 1 Then Energy := 1;
  Score := Cost / Energy * ScoreBonus;
  If Score < SearchScore Then
  Begin
    SearchScore := Score;
    SearchFont := FontNo;
    SearchEm := Em100;
  End;
End;

{ Les applications utilisent des tailles usuelles (entiers en pixels, ou points
  convertis a 96 ppp : 8 pt = 10,67 px, 10 pt = 13,33 px, 11 pt = 14,67 px ...).
  On s'y cale quand la taille mesuree en est a moins de 0,25 pixel. }
Function SnapToUsualSize(Em100: Integer): Integer;
Const
  Points: Array[0..4] Of Integer = (1067, 1333, 1467, 1867, 2133);
Var
  I, Best: Integer;
Begin
  Best := ((Em100 + 50) Div 100) * 100;
  For I := 0 To 4 Do
    If Abs(Points[I] - Em100) < Abs(Best - Em100) Then Best := Points[I];
  If Abs(Best - Em100) <= 25 Then
    SnapToUsualSize := Best
  Else
    SnapToUsualSize := Em100;
End;

{ Essaie les tailles usuelles voisines (entier de pixels, 8/10/11/14/16 pt)
  avec l'evaluation fidele ; une taille usuelle l'emporte a score presque egal. }
Procedure TryNominalSizes(FontNo, Center: Integer);
Const
  Points: Array[0..4] Of Integer = (1067, 1333, 1467, 1867, 2133);
Var
  I, Candidate: Integer;
Begin
  FullScoring := True;
  SearchScore := 1E30;
  ScoreBonus := 1;
  TryCandidate(FontNo, Center);
  ScoreBonus := 0.94;
  Candidate := ((Center + 50) Div 100) * 100;
  If (Candidate <> Center) And (Abs(Candidate - Center) <= 60) Then
    TryCandidate(FontNo, Candidate);
  For I := 0 To 4 Do
    If (Points[I] <> Center) And (Abs(Points[I] - Center) <= 60) Then
      TryCandidate(FontNo, Points[I]);
  ScoreBonus := 1;
  FullScoring := False;
End;

{ Choix de la police et de la taille : recherche grossiere, fine, puis tailles usuelles. }
Procedure ChooseFont(Height75: Integer);
Var
  FontNo, FirstFont, LastFont, Em, Center, EmLow, EmHigh, CoarseStep, FineStep, FineSpan: Integer;
  ExactScore: Real;
Begin
  CoarseStep := 40;
  FineStep := 10;
  FineSpan := 2;
  If (LanguageMask And LangJapanese) <> 0 Then
  Begin
    CoarseStep := 60;
    FineStep := 30;
    FineSpan := 2;
  End;
  If (FontOption = FontAuto) And ((LanguageMask And LangJapanese) <> 0) Then
  Begin
    { Les kana sont communs a toutes les polices : seules Segoe UI et Yu Gothic
      (police japonaise habituelle) se distinguent par leurs lettres latines. }
    FirstFont := FontSegoe;
    LastFont := FontYuGothic;
  End
  Else If FontOption = FontAuto Then
  Begin
    FirstFont := FontSegoe;
    LastFont := FontConsolas;
  End
  Else
  Begin
    FirstFont := FontOption;
    LastFont := FontOption;
  End;
  FullScoring := False;
  CoarsePass := False;
  UseExact := True;
  ScoreBonus := 1;
  SearchScore := 1E30;
  SearchFont := FirstFont;
  SearchEm := SizeOption;
  If SizeOption <> 0 Then
  Begin
    If FirstFont <> LastFont Then
      For FontNo := FirstFont To LastFont Do
        TryCandidate(FontNo, SizeOption);
  End
  Else
  Begin
    EmLow := ClampTo(Integer((Longint(Height75) * 10000) Div 135), 600, 4800);
    EmHigh := ClampTo(Integer((Longint(Height75) * 10000) Div 85), 600, 4800);
    EvalTotal := ((LastFont - FirstFont + 1) * ((EmHigh - EmLow) Div CoarseStep + 1)) +
                 2 * FineSpan + 5 + 5;
    CoarsePass := True;
    For FontNo := FirstFont To LastFont Do
    If Not (((LanguageMask And LangJapanese) <> 0) And (FontNo In [FontArial, FontConsolas])) Then
    Begin
      Em := EmLow;
      While Em <= EmHigh Do
      Begin
        TryCandidate(FontNo, Em);
        Inc(Em, CoarseStep);
      End;
    End;
    CoarsePass := False;
    FontNo := SearchFont;
    SearchScore := 1E30;
    Center := SearchEm;
    TryCandidate(FontNo, Center);
    For Em := -FineSpan To FineSpan Do
      If (Em <> 0) And (Center + Em * FineStep >= 600) And (Center + Em * FineStep <= 4800) Then
        TryCandidate(FontNo, Center + Em * FineStep);
    Center := SearchEm;
    For Em := -2 To 2 Do
      If Em <> 0 Then TryCandidate(FontNo, Center + Em * (FineStep Div 2));
    TryNominalSizes(FontNo, SearchEm);
  End;
  CurrentFont := SearchFont;
  CurrentEm := SearchEm;
  If SizeOption = 0 Then CurrentEm := SnapToUsualSize(CurrentEm);
  { A 13,33 px les gabarits Segoe exacts sont tres precis mais sensibles a la
    taille reelle : on garde ceux qui s'ajustent le mieux, exacts ou derives. }
  UseExact := True;
  If (CurrentFont = FontSegoe) And (CurrentEm = ExactEm) And (SizeOption = 0) Then
  Begin
    FullScoring := True;
    ScoreBonus := 1;
    SearchScore := 1E30;
    UseExact := True;
    TryCandidate(FontSegoe, ExactEm);
    ExactScore := SearchScore;
    SearchScore := 1E30;
    UseExact := False;
    TryCandidate(FontSegoe, ExactEm);
    If SearchScore < ExactScore Then UseExact := False Else UseExact := True;
    FullScoring := False;
  End;
End;

Procedure RecognizeText;
Var
  I, J, Number, Pitch, Spaces, Rounded, MinStart, RunCount, LineBase, PreviousBase: Integer;
  Estimate, BestBase, Base, GlyphIndex, Blanks, Delta: Integer;
  RowA, RowB, Count, EndColumn, SpaceQ, Height75: Integer;
  Previous, Next, Drop, BestDrop, CostValue, BestValue, ExpectedPen, Gap: Longint;
  Row: PImageRow;
  InRun: Boolean;
  DeltaHistogram: Array[0..400] Of Integer;
  HeightHistogram: Array[0..255] Of Integer;
  Total, Accumulated: Longint;
Begin
  If ImageWidth > MaxRecognizeWidth Then
  Begin
    Writeln('Erreur : image trop large pour la reconnaissance (maximum 16000 pixels).');
    Halt(2);
  End;
  FillChar(Templates, SizeOf(Templates), 0);
  GetMem(BestCost, Word((ImageWidth + 8) * SizeOf(Longint)));
  GetMem(PrefixSquares, Word((ImageWidth + 8) * SizeOf(Longint)));
  GetMem(ColumnSquares, Word((ImageWidth + 8) * SizeOf(Longint)));
  GetMem(ColumnMax, ImageWidth + 8);
  GetMem(BackX, Word((ImageWidth + 8) * SizeOf(Word)));
  GetMem(BackT, Word((ImageWidth + 8) * SizeOf(Word)));
  GetMem(BackS, Word((ImageWidth + 8) * SizeOf(Word)));
  GetMem(OutX, Word((ImageWidth + 8) * SizeOf(Word)));
  GetMem(OutT, Word((ImageWidth + 8) * SizeOf(Word)));
  GetMem(LineBuffer, Word((ImageWidth + 16) * SizeOf(Word)));
  GetMem(LineTop, SizeOf(TIntegerArray));
  GetMem(LineBottom, SizeOf(TIntegerArray));
  GetMem(LineEstimate, SizeOf(TIntegerArray));
  GetMem(LineFirst, SizeOf(TIntegerArray));
  GetMem(LineInk, SizeOf(TLongArray));

  { Passe 1 : reperer les lignes de texte (rangees contenant de l'encre). }
  LineCount := 0;
  LineLength := 0;
  Number := 1;
  While Number <= ImageHeight Do
  Begin
    While (Number <= ImageHeight) And (Not RowHasText(Number)) Do
      Inc(Number);
    If Number <= ImageHeight Then
    Begin
      LineTop^[LineCount] := Number;
      While (Number <= ImageHeight) And RowHasText(Number) Do
        Inc(Number);
      LineBottom^[LineCount] := Number - 1;
      Inc(LineCount);
    End;
  End;
  If LineCount = 0 Then
  Begin
    Writeln('Aucun texte trouve dans l''image.');
    Exit;
  End;

  For I := 0 To LineCount - 1 Do
  Begin
    RowA := LineTop^[I] - 2;
    If RowA < 1 Then RowA := 1;
    RowB := LineBottom^[I] + 2;
    If RowB > ImageHeight Then RowB := ImageHeight;
    Previous := RowSum(RowA);
    LineInk^[I] := 0;
    BestDrop := -Infinity;
    Estimate := RowA;
    For Number := RowA To RowB - 1 Do
    Begin
      Next := RowSum(Number + 1);
      Drop := Previous - Next;
      If Drop > BestDrop Then
      Begin
        BestDrop := Drop;
        Estimate := Number;
      End;
      If (Number >= LineTop^[I]) And (Number <= LineBottom^[I]) Then
        Inc(LineInk^[I], Previous);
      Previous := Next;
    End;
    LineEstimate^[I] := Estimate;

    LineFirst^[I] := ImageWidth;
    For Number := LineTop^[I] To LineBottom^[I] Do
    Begin
      Row := Image^[Number];
      For J := 1 To LineFirst^[I] - 1 Do
        If Row^[J] >= InkLevel Then
        Begin
          LineFirst^[I] := J;
          Break;
        End;
    End;
  End;

  MinStart := ImageWidth;
  For I := 0 To LineCount - 1 Do
    If LineFirst^[I] < MinStart Then MinStart := LineFirst^[I];

  { Interligne : premier quartile des ecarts entre lignes de base. }
  Step('Lignes de texte reperees : ' + NumberText(LineCount) + '.');
  FillChar(DeltaHistogram, SizeOf(DeltaHistogram), 0);
  Total := 0;
  For I := 1 To LineCount - 1 Do
  Begin
    Delta := LineEstimate^[I] - LineEstimate^[I - 1];
    If (Delta >= 8) And (Delta <= 400) Then
    Begin
      Inc(DeltaHistogram[Delta]);
      Inc(Total);
    End;
  End;
  Pitch := 0;
  Accumulated := 0;
  For Delta := 8 To 400 Do
  Begin
    Inc(Accumulated, DeltaHistogram[Delta]);
    If (Pitch = 0) And (Total > 0) And (Accumulated * 4 >= Total) Then Pitch := Delta;
  End;

  { Hauteur typique d'une ligne (75e centile) et lignes echantillons. }
  FillChar(HeightHistogram, SizeOf(HeightHistogram), 0);
  For I := 0 To LineCount - 1 Do
    Inc(HeightHistogram[ClampTo(LineBottom^[I] - LineTop^[I] + 1, 0, 255)]);
  Height75 := 255;
  Accumulated := 0;
  For J := 0 To 255 Do
  Begin
    Inc(Accumulated, HeightHistogram[J]);
    If Accumulated * 4 >= Longint(LineCount) * 3 Then
    Begin
      Height75 := J;
      Break;
    End;
  End;
  SampleCount := 0;
  For J := 0 To 3 Do
  Begin
    BestValue := -1;
    BestBase := -1;
    For I := 0 To LineCount - 1 Do
      If (LineBottom^[I] - LineTop^[I] + 1 >= (Height75 * 3) Div 4) And
         (Not IsSampleLine(I)) And
         (LineInk^[I] > BestValue) Then
      Begin
        BestValue := LineInk^[I];
        BestBase := I;
      End;
    If BestBase >= 0 Then
    Begin
      SampleLine[SampleCount] := BestBase;
      Inc(SampleCount);
    End;
  End;
  If SampleCount = 0 Then
  Begin
    SampleLine[0] := 0;
    SampleCount := 1;
  End;

  Step('Detection de la police et de la taille ...');
  EvalCount := 0;
  ChooseFont(Height75);
  Progress('Preparation des gabarits ...');
  BuildTemplates(CurrentFont, CurrentEm, TotalGlyphs);
  MaxOverlapUsed := MaxOverlap;
  SpaceQ := (Longint(FontSpace) * CurrentEm * 4 + 51200) Div 102400;
  If SpaceQ < 4 Then SpaceQ := 4;
  Step('Police detectee : ' + FontNames[CurrentFont] + ' ' + EmText(CurrentEm));

  { Passe 2 : reconnaitre chaque ligne. }
  PreviousBase := 0;
  For I := 0 To LineCount - 1 Do
  Begin
    Progress('Reconnaissance : ligne ' + NumberText(I + 1) + '/' + NumberText(LineCount) +
             ' (' + NumberText(Longint(I) * 100 Div LineCount) + ' %)');
    PrepareLine(LineTop^[I], LineBottom^[I]);

    RunCount := 0;
    InRun := False;
    For J := 0 To ImageWidth - 1 Do
      If ColumnMax^[J] >= InkLevel Then
      Begin
        If Not InRun Then Inc(RunCount);
        InRun := True;
      End
      Else
        InRun := False;

    If (RunCount <= 4) Or ((LanguageMask And LangJapanese) <> 0) Then
    Begin
      BestBase := LineBottom^[I];
      BestValue := Infinity * 2;
      For Base := LineBottom^[I] - CurrentEm Div 300 - 1 To LineBottom^[I] Do
      Begin
        CostValue := MatchLine(Base);
        If CostValue < BestValue Then
        Begin
          BestValue := CostValue;
          BestBase := Base;
        End;
      End;
      LineBase := BestBase;
    End
    Else
      LineBase := LineEstimate^[I];
    MatchLine(LineBase);

    { Retour arriere : suite des gabarits retenus. }
    Count := 0;
    EndColumn := ImageWidth;
    While EndColumn > 0 Do
    Begin
      If BackT^[EndColumn] <> 0 Then
      Begin
        OutX^[Count] := BackS^[EndColumn];
        OutT^[Count] := BackT^[EndColumn] - 1;
        Inc(Count);
      End;
      EndColumn := BackX^[EndColumn];
    End;

    { Lignes vides entre deux lignes de texte. }
    If (I > 0) And (Pitch > 0) Then
    Begin
      Blanks := (2 * (LineBase - PreviousBase) + Pitch) Div (2 * Pitch) - 1;
      While Blanks > 0 Do
      Begin
        Writeln(OutputFile);
        Dec(Blanks);
      End;
    End;
    PreviousBase := LineBase;

    { Indentation en espaces de la police ; on s'aligne sur 4 espaces. }
    Spaces := ((LineFirst^[I] - MinStart) * 8 + SpaceQ) Div (2 * SpaceQ);
    Rounded := ((Spaces + 2) Div 4) * 4;
    If Abs(Spaces - Rounded) <= 1 Then Spaces := Rounded;
    AppendSpaces(Spaces);

    { Espaces entre caracteres : ecart entre la position attendue du
      crayon (crayon precedent + chasse) et la position reelle, en quarts de pixel. }
    ExpectedPen := -1000000;
    For J := Count - 1 Downto 0 Do
    Begin
      GlyphIndex := OutT^[J];
      If ExpectedPen > -1000000 Then
      Begin
        Gap := Longint(OutX^[J]) * 4 + Templates[GlyphIndex].Pen - ExpectedPen;
        If Gap > 0 Then
          AppendSpaces((Gap * 10 + 3 * SpaceQ) Div (10 * SpaceQ));
      End;
      AppendCode(GlyphCodeOf(GlyphIndex Shr 2));
      ExpectedPen := Longint(OutX^[J]) * 4 + Templates[GlyphIndex].Pen +
                     Templates[GlyphIndex].Advance;
    End;
    FlushLine;
  End;
End;

Procedure RecognizeLegacy;
Begin
  Y := 1;
  While Y <= ImageHeight Do
  Begin
    While (Y <= ImageHeight) And (Not RowHasInk(Y)) Do
      Inc(Y);
    If Y <= ImageHeight Then
    Begin
      TopY := Y;
      While (Y <= ImageHeight) And RowHasInk(Y) Do
        Inc(Y);
      BottomY := Y - 1;
      RecognizedLine := '';
      PreviousRight := 0;
      CurrentX := 1;
      While CurrentX <= ImageWidth Do
      Begin
        While (CurrentX <= ImageWidth) And
              (Not ColumnHasInk(CurrentX, TopY, BottomY)) Do
          Inc(CurrentX);
        If CurrentX <= ImageWidth Then
        Begin
          LeftX := CurrentX;
          While (CurrentX <= ImageWidth) And
                ColumnHasInk(CurrentX, TopY, BottomY) Do
            Inc(CurrentX);
          RightX := CurrentX - 1;
          If (PreviousRight > 0) And (LeftX - PreviousRight > 2) Then
            RecognizedLine := RecognizedLine + ' ';
          RecognizedLine := RecognizedLine +
            RecognizeGlyph(LeftX, RightX, TopY, BottomY);
          PreviousRight := RightX;
        End;
      End;
      If Not LegacyDry Then Writeln(OutputFile, RecognizedLine);
    End;
  End;
End;

{ Langues : eng, fra, deu, spa, por, combinables avec + (ex. fra+eng). }
Function ParseLanguages(Text1: String): Integer;
Var
  Mask, Position: Integer;
  Name: String;
Begin
  Mask := 0;
  Text1 := Text1 + '+';
  Position := Pos('+', Text1);
  While Position > 0 Do
  Begin
    Name := Copy(Text1, 1, Position - 1);
    Delete(Text1, 1, Position);
    If Name = 'eng' Then
      Mask := Mask Or LangEnglish
    Else If Name = 'fra' Then
      Mask := Mask Or LangFrench
    Else If Name = 'deu' Then
      Mask := Mask Or LangGerman
    Else If Name = 'spa' Then
      Mask := Mask Or LangSpanish
    Else If Name = 'por' Then
      Mask := Mask Or LangPortuguese
    Else If Name = 'swe' Then
      Mask := Mask Or LangSwedish
    Else If Name = 'ita' Then
      Mask := Mask Or LangItalian
    Else If Name = 'sqi' Then
      Mask := Mask Or LangAlbanian
    Else If Name = 'dan' Then
      Mask := Mask Or LangDanish
    Else If Name = 'jpn' Then
      Mask := Mask Or LangJapanese
    Else
    Begin
      Writeln('Erreur : langue non prise en charge : ', Name,
              ' (eng, fra, deu, spa, por, swe, ita, sqi, dan, jpn).');
      Halt(2);
    End;
    Position := Pos('+', Text1);
  End;
  ParseLanguages := Mask;
End;

BEGIN
  If (ParamCount >= 1) And
     ((ParamStr(1) = '/?') Or (ParamStr(1) = '-?') Or
      (ParamStr(1) = '-h') Or (ParamStr(1) = '--help')) Then
  Begin
    ShowHelp;
    Halt(0);
  End;

  If ParamCount < 2 Then
  Begin
    ShowHelp;
    Halt(2);
  End;

  UseLegacy := False;
  FontOption := FontAuto;
  SizeOption := 0;
  LanguageMask := LangFrench;
  ArgumentIndex := 3;
  While ArgumentIndex <= ParamCount Do
  Begin
    If ParamStr(ArgumentIndex) = '-l' Then
    Begin
      If ArgumentIndex = ParamCount Then
      Begin
        Writeln('Erreur : la langue est manquante apres -l.');
        Halt(2);
      End;
      LanguageMask := ParseLanguages(ParamStr(ArgumentIndex + 1));
      Inc(ArgumentIndex);
    End
    Else If ParamStr(ArgumentIndex) = '-f' Then
    Begin
      If ArgumentIndex = ParamCount Then FontOption := -2;
      If ArgumentIndex < ParamCount Then
      Begin
        If ParamStr(ArgumentIndex + 1) = 'auto' Then
          FontOption := FontAuto
        Else If ParamStr(ArgumentIndex + 1) = 'segoe' Then
          FontOption := FontSegoe
        Else If ParamStr(ArgumentIndex + 1) = 'arial' Then
          FontOption := FontArial
        Else If ParamStr(ArgumentIndex + 1) = 'consolas' Then
          FontOption := FontConsolas
        Else If ParamStr(ArgumentIndex + 1) = 'yugothic' Then
          FontOption := FontYuGothic
        Else If ParamStr(ArgumentIndex + 1) = '5x7' Then
          UseLegacy := True
        Else
          FontOption := -2;
      End;
      If FontOption = -2 Then
      Begin
        Writeln('Erreur : la police doit etre auto, segoe, arial, consolas, yugothic ou 5x7.');
        Halt(2);
      End;
      Inc(ArgumentIndex);
    End
    Else If ParamStr(ArgumentIndex) = '-s' Then
    Begin
      OptionError := 1;
      If ArgumentIndex < ParamCount Then
        Val(ParamStr(ArgumentIndex + 1), OptionValue, OptionError);
      If (OptionError <> 0) Or (OptionValue < 6) Or (OptionValue > 48) Then
      Begin
        Writeln('Erreur : la taille (em en pixels) doit etre entre 6 et 48.');
        Halt(2);
      End;
      SizeOption := Round(OptionValue * 100);
      Inc(ArgumentIndex);
    End
    Else
    Begin
      Writeln('Erreur : option non reconnue : ', ParamStr(ArgumentIndex));
      Halt(2);
    End;
    Inc(ArgumentIndex);
  End;

  ImageName := ParamStr(1);
  OutputName := ParamStr(2);
  If Length(OutputName) > 251 Then
  Begin
    Writeln('Erreur : le nom du fichier de sortie est trop long.');
    Halt(2);
  End;
  OutputName := OutputName + '.txt';

  StartTime := ClockHundredths;
  Step('Lecture de l''image ' + ImageName + ' ...');
  Case DetectFormat Of
    FormatPng: LoadPng;
    FormatJpeg: LoadJpeg;
    FormatGif: LoadGif;
    FormatBmp: LoadBmp;
  Else
    LoadPbm;
  End;
  Step('Image chargee : ' + NumberText(ImageWidth) + ' x ' + NumberText(ImageHeight) +
       ' pixels.');
  NormalizeImage;
  Step('Image normalisee (fond et encre).');
  { Image de la police matricielle 5 x 7 : ses glyphes collent presque parfaitement
    a la grille, ce qui n'arrive jamais avec un vrai texte. }
  If (Not UseLegacy) And (FontOption = FontAuto) And (SizeOption = 0) Then
  Begin
    Step('Test de la police matricielle 5 x 7 ...');
    LegacyDry := True;
    DryGlyphs := 0;
    DryErrors := 0;
    RecognizeLegacy;
    LegacyDry := False;
    If (DryGlyphs > 0) And (DryErrors <= DryGlyphs * 3) Then
    Begin
      UseLegacy := True;
      Step('Police matricielle 5 x 7 reconnue.');
    End;
  End;

  Assign(OutputFile, OutputName);
  {$I-}
  Rewrite(OutputFile);
  {$I+}
  If IOResult <> 0 Then
  Begin
    Writeln('Erreur : impossible de creer le fichier texte de sortie.');
    Halt(2);
  End;

  If UseLegacy Then
    RecognizeLegacy
  Else
    RecognizeText;
  Close(OutputFile);
  Step('Reconnaissance terminee : ' + OutputName);
END.
